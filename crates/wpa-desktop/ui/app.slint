// windpencilagent 基座主界面（Slint）
// 结构：左导航 200px ｜ 中央内容（页头 + 视图 + 输入区）｜ 右栏 272px 运行看板
// 设计令牌来自 ui/kit/tokens.slint（双主题）；组件来自 ui/kit（全量入库）。

import { Theme } from "kit/tokens.slint";
import { Icons } from "kit/icons.slint";
import { ScrollView, TextEdit, LineEdit, CheckBox } from "std-widgets.slint";
import { Button } from "kit/components/button.slint";
import { Input } from "kit/components/input.slint";
import { Switch } from "kit/components/switch.slint";
import { ProgressBar } from "kit/components/progress_bar.slint";
import { Badge, BadgeStatus } from "kit/components/badge.slint";
import { Separator } from "kit/components/separator.slint";
import { Spinner } from "kit/components/spinner.slint";
import { Toast } from "kit/components/toast.slint";
import { Card } from "kit/components/card.slint";
import { Slider } from "kit/components/slider.slint";
import { Checkbox } from "kit/components/checkbox.slint";
import { Textarea } from "kit/components/textarea.slint";
import { Table, TableColumn } from "kit/components/table.slint";
import { Dialog } from "kit/components/dialog.slint";
import { Stepper } from "kit/components/stepper.slint";
import { Chart } from "kit/components/chart.slint";
import { Gauge } from "kit/components/gauge.slint";
import { Breadcrumb, BreadcrumbItem } from "kit/components/breadcrumb.slint";
import { KitGallery } from "kit_gallery.slint";

// ---------------------------------------------------------------------------
// 数据契约（与 wpa-engine::snapshot 对应）
// ---------------------------------------------------------------------------

export struct ChatMsg {
    role: string,      // user / assistant / trace / system
    text: string,
}

export struct TraceRow {
    icon: string,
    title: string,
    status: string,    // ok / err / run / ask
}

export struct ToolRow {
    name: string,
    group: string,
    risk: string,
    desc: string,
}

/// 能力页左栏：基座能力组（与插件契约组 GroupRow 分开）
export struct CapGroupRow {
    id: string,
    label: string,
    source: string,
    tools: int,
    declared: bool,
}

/// 组勾选 chip（领域组绑定 / 空间工具组白名单共用）
export struct DomainGroupChip {
    id: string,
    label: string,
    declared: bool,
    /// 该组在全局是否启用：禁用的组可以看见、可以引用，但工具不会生效
    enabled: bool,
}

/// 注册表里的组（能力页左栏，含插件组）
export struct RegGroupRow {
    id: string,
    label: string,
    source: string,
    /// 组描述：说明本组工具类别，便于大模型判断何时用
    description: string,
    enabled: bool,
    total: int,
    active: int,
    broken: int,
    discovered: int,
}

/// 注册表里的条目（能力页中栏）
export struct RegEntryRow {
    id: string,
    group: string,
    name: string,
    source: string,
    risk: string,
    status: string,
    enabled: bool,
    installed: bool,
    /// 未安装但文件齐备：可安装（扫描候选）
    installable: bool,
    group-enabled: bool,
    note: string,
}

export struct SpaceRow {
    name: string,
    active: bool,
    plugins: int,
    note: string,
    /// 绑定的本地目录（shell/文件工具落点）
    cwd: string,
    /// 工具白名单（Rust 侧用换行拼好）
    whitelist: string,
    /// 权限模式："global"（默认继承全局）/ "unrestricted"（允许完全访问）
    permission: string,
    /// 沙箱："on" / "off"
    sandbox: string,
}

export struct ModelRow {
    name: string,
    model: string,
    ctx: int,
    tools-ok: bool,
    active: bool,
}

export struct TaskRow {
    /// 任务 id（删除/移动用；来自 TaskRecord.id）
    id: string,
    title: string,
    status: string,
    col: int,          // 0 待规划 / 1 待办 / 2 进行中 / 3 已完成
}

/// 会话行（空间页会话管理）
export struct SessionRow {
    id: string,
    preview: string,   // 首条用户消息摘要
    turns: int,
    updated: string,   // 更新时间（本地时间字符串）
    space: string,
}

/// 知识条目行（领域页知识管理）
export struct KnowledgeRow {
    name: string,
    excerpt: string,
}

export struct DayRow {
    date: string,
    chars: int,
}

// ---------------------------------------------------------------------------
// 侧栏导航项
// ---------------------------------------------------------------------------

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <int> index;
    in property <int> current;
    in property <bool> has-badge: false;
    in property <string> badge-text: "";
    /// 二级项：缩进显示（配置的 4 个子页）
    in property <bool> sub: false;

    callback picked(int);

    height: sub ? 32px : 36px;
    background: root.current == root.index ? Theme.palette.surface_raised : (ta.has-hover ? Theme.palette.hover_overlay : Colors.transparent);
    border-radius: 6px;

    HorizontalLayout {
        padding-left: root.sub ? 24px : 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: start;

        Image {
            source: root.icon;
            colorize: root.current == root.index ? Theme.palette.primary : Theme.palette.text_secondary;
            width: 16px;
            height: 16px;
        }
        Text {
            text: root.label;
            color: root.current == root.index ? Theme.palette.text_primary : Theme.palette.text_secondary;
            font-family: Theme.typography.font_family;
            font-size: Theme.typography.body_size;
            font-weight: root.current == root.index ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.has-badge : Text {
            text: root.badge-text;
            color: Theme.palette.text_secondary;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(root.index); }
    }
}

component NavGroup {
    in property <string> title;
    VerticalLayout {
        spacing: 2px;
        padding-top: 6px;
        padding-left: 10px;
        Text {
            text: root.title;
            color: Theme.palette.text_disabled;
            font-size: 11px;
            height: 20px;
            vertical-alignment: center;
        }
        @children
    }
}

// 轨迹图标：按 status 选 SVG，避免 Unicode 符号在无字形字体下显示成方块。
component TraceIcon inherits Rectangle {
    in property <string> status;
    width: 14px;
    height: 14px;
    Image {
        source: root.status == "ok" ? Icons.check
              : root.status == "err" ? Icons.close
              : root.status == "ask" ? Icons.warning
              : root.status == "run" ? Icons.arrow-right
              : Icons.info;
        colorize: root.status == "err" ? Theme.palette.critical
                : root.status == "ok" ? Theme.palette.success
                : root.status == "ask" ? Theme.palette.warning
                : Theme.palette.text_disabled;
        width: 14px;
        height: 14px;
    }
}

// ---------------------------------------------------------------------------
// 消息气泡
// ---------------------------------------------------------------------------

component Bubble {
    in property <string> role;
    in property <string> text;
    in property <bool> is-user: root.role == "user";
    in property <bool> is-trace: root.role == "trace";
    callback copy(string);

    height: self-layout.preferred-height;

    self-layout := VerticalLayout {
        spacing: 4px;

        if root.is-trace : Rectangle {
            height: 22px;
            border-radius: 4px;
            background: Colors.transparent;
            HorizontalLayout {
                padding-left: 8px;
                spacing: 6px;
                alignment: start;
                Text {
                    text: "·";
                    color: Theme.palette.text_disabled;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.text;
                    color: Theme.palette.text_secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        if !root.is-trace && root.is-user : HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                background: Theme.palette.primary;
                border-radius: 10px;
                max-width: 520px;
                VerticalLayout {
                    padding: 9px;
                    Text {
                        text: root.text;
                        color: Theme.palette.on_primary;
                        font-family: Theme.typography.font_family;
                        font-size: Theme.typography.body_size;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 18px;
                        HorizontalLayout { alignment: end;
                            Rectangle {
                                width: 40px;
                                height: 18px;
                                Text {
                                    text: "复制";
                                    color: Theme.palette.on_primary;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                                TouchArea { clicked => { root.copy(root.text); } }
                            }
                        }
                    }
                }
            }
        }

        if !root.is-trace && !root.is-user : Rectangle {
            background: Theme.palette.surface_raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.palette.border;
            VerticalLayout {
                padding: 9px;
                Text {
                    text: root.text;
                    color: Theme.palette.text_primary;
                    font-family: Theme.typography.font_family;
                    font-size: Theme.typography.body_size;
                    wrap: word-wrap;
                }
                // 复制按钮（#8）：贴着气泡右下角，hover 才显形，平时不干扰阅读
                Rectangle {
                    height: 20px;
                    HorizontalLayout { alignment: end;
                        Rectangle {
                            width: 42px;
                            height: 20px;
                            border-radius: 4px;
                            background: copy-ta.has-hover ? Theme.palette.hover_overlay : Colors.transparent;
                            Text {
                                text: "复制";
                                color: Theme.palette.text_secondary;
                                font-size: 10px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            copy-ta := TouchArea { clicked => { root.copy(root.text); } }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// 状态条选择器 chip（#8）：点击展开选项列表就地切换，不再跳页。
// 不用 PopupWindow（本版在组件内定位/尺寸异常），用绝对定位覆盖层。
// ---------------------------------------------------------------------------

component ChipSelect inherits Rectangle {
    in property <string> label;
    in property <string> current;
    in property <[string]> options;
    in property <bool> accent: false;
    callback selected(string);
    in-out property <bool> open: false;

    height: 26px;
    width: 132px;

    Rectangle {
        border-radius: 13px;
        background: root.accent ? Theme.palette.primary : Theme.palette.surface;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 4px;
            Text {
                text: root.label + (root.current == "" ? "" : root.current);
                color: root.accent ? Theme.palette.on_primary : Theme.palette.text_primary;
                font-size: 11px;
                vertical-alignment: center;
            }
            Image {
                source: Icons.arrow-downward;
                colorize: root.accent ? Theme.palette.on_primary : Theme.palette.text_primary;
                width: 12px;
                height: 12px;
                transform-rotation: root.open ? 180deg : 0deg;
            }
        }
        TouchArea { clicked => { root.open = !root.open; } }
    }

    // 覆盖层：定位到 chip 正下方（Rectangle 默认不裁剪，可溢出到状态条之外）
    if root.open : Rectangle {
        x: 0;
        y: 28px;
        width: max(160px, root.width);
        height: min(root.options.length * 28px + 8px, 232px);
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.palette.border;
        background: Theme.palette.surface_raised;
        drop-shadow-blur: 10px;
        drop-shadow-color: rgba(0, 0, 0, 0.25);
        clip: true;
        VerticalLayout {
            padding: 4px;
            spacing: 0px;
            for opt in root.options : Rectangle {
                height: 28px;
                border-radius: 4px;
                background: opt-ta.has-hover ? Theme.palette.hover_overlay : Colors.transparent;
                HorizontalLayout { padding-left: 8px;
                    Text {
                        text: opt;
                        color: Theme.palette.text_primary;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                opt-ta := TouchArea {
                    clicked => { root.selected(opt); root.open = false; }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// 页面：对话
// ---------------------------------------------------------------------------

component ChatPage {
    in property <[ChatMsg]> messages;
    in property <bool> busy;
    // 消息条数变化触发自动滚屏（changed 只能监听属性，不能监听 .length 路径）
    property <int> msg-count: root.messages.length;
    in property <string> model-name;
    in property <string> tree-name;
    in property <int> tool-count;
    // 状态条：当前工作空间 / 领域 / 模型 / 上下文占比 / token 花费
    in property <string> space-name;
    in property <string> domain-name;
    in property <[string]> space-options;
    in property <[string]> domain-options;
    in property <[string]> model-options;
    in property <bool> degraded;  // 降级模式（无可用模型）：顶部条显示"降级"
    in property <int> ctx-window: 32000;
    in property <int> ctx-used: 0;
    in property <float> ctx-pct: 0.0;
    in property <int> tokens-in: 0;
    in property <int> tokens-out: 0;
    // chip 现在是真选择器：选中项直接切换，不再跳页
    callback space-select(string);
    callback domain-select(string);
    callback model-select(string);
    callback copy-message(string);
    callback jump-space();
    callback jump-model();
    callback jump-config();

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        VerticalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            spacing: 0;

            // 常驻状态条（44px）：这一轮到底用的哪个空间、哪个领域、哪个模型、
            // 上下文吃掉了多少、花了多少 token —— 不用翻页去猜。
            Rectangle {
                height: 42px;
                background: Theme.palette.surface_raised;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    ChipSelect {
                        label: "空间 ";
                        current: space-name == "" ? "全局" : space-name;
                        options: root.space-options;
                        selected(n) => { root.space-select(n); }
                    }
                    ChipSelect {
                        label: "领域 ";
                        current: domain-name == "" ? "无" : domain-name;
                        options: root.domain-options;
                        selected(n) => { root.domain-select(n); }
                    }
                    ChipSelect {
                        label: "模型 ";
                        current: model-name == "" ? "未配置" : model-name;
                        options: root.model-options;
                        accent: model-name != "";
                        selected(n) => { root.model-select(n); }
                    }
                    if root.degraded : Rectangle {
                        width: 44px;
                        height: 20px;
                        border-radius: 4px;
                        background: Theme.palette.critical;
                        Text {
                            text: "降级";
                            color: Theme.palette.on_primary;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: "上下文 " + (ctx-used / 1000) + "k/" + (ctx-window / 1000) + "k　"
                            + round(ctx-pct * 100) + "%";
                        color: ctx-pct > 0.8 ? Theme.palette.critical : Theme.palette.text_secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "↑" + tokens-in + " ↓" + tokens-out;
                        color: Theme.palette.text_secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }

            if root.messages.length == 0 : Rectangle {
                VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    padding: 40px;
                    Text {
                        text: "windpencilagent";
                        color: Theme.palette.text_primary;
                        font-size: 26px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "通用智能体基座";
                        color: Theme.palette.text_secondary;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "当前模型 " + (root.model-name == "" ? "未配置（降级：仅通用命令）" : root.model-name)
                            + "　·　工具 " + root.tool-count + " 个";
                        color: Theme.palette.text_disabled;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "试着输入：帮我看看当前目录有哪些文件";
                        color: Theme.palette.text_disabled;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                content-width: self.width;

                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 10px;

                    for m in root.messages : Bubble {
                        role: m.role;
                        text: m.text;
                        copy(t) => { root.copy-message(t); }
                    }

                    if root.busy : Rectangle {
                        height: 28px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Spinner { size: 16px; stroke-width: 2px; }
                            Text {
                                text: "思考中…";
                                color: Theme.palette.text_secondary;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // 哨兵：消息变化后让这一行可见 = 滚到最新内容
                    chat-tail := Rectangle { height: 1px; }
                }
            }
        }
    }

    // 延迟一帧再滚：此时新消息的 content-height 已重算，ensure-visible 能算对底部
    chat-scroll-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            chat-tail.ensure-visible(ScrollBehavior.instant);
            self.running = false;
        }
    }
    changed msg-count => { chat-scroll-timer.running = true; }
}

// ---------------------------------------------------------------------------
// 页面：任务板
// ---------------------------------------------------------------------------

component StatCard inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <int> tone;
    horizontal-stretch: 1;
    height: 68px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.palette.border;
    background: Theme.palette.surface_raised;
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text {
            text: root.label;
            color: Theme.palette.text_secondary;
            font-size: 11px;
        }
        Text {
            text: root.value;
            color: root.tone == 3 ? Theme.palette.success : (root.tone == 2 ? Theme.palette.primary : Theme.palette.text_primary);
            font-size: 22px;
            font-weight: 600;
        }
    }
}

component TaskColumn inherits Rectangle {
    in property <string> title;
    in property <int> col-index;
    in property <[TaskRow]> tasks;
    callback task-move(string, int);
    callback task-delete(string);

    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.palette.border;
    background: Theme.palette.surface_raised;
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Text {
            text: root.title + "　" + root.tasks.length;
            color: Theme.palette.text_primary;
            font-size: 13px;
            font-weight: 600;
        }
        ScrollView {
            vertical-stretch: 1;
            content-width: self.width;
            VerticalLayout {
                spacing: 6px;
                for t in root.tasks : Rectangle {
                    height: 62px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.palette.border;
                    background: Theme.palette.surface;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Text {
                            text: t.title;
                            color: Theme.palette.text_primary;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            // 左移/右移：在本列内改状态——用按钮明确可操作，不依赖拖拽
                            if root.col-index > 0 : Button {
                                text: "←";
                                width: 30px; height: 22px; outlined: true;
                                clicked => { root.task-move(t.id, root.col-index - 1); }
                            }
                            if root.col-index < 3 : Button {
                                text: "→";
                                width: 30px; height: 22px; outlined: true;
                                clicked => { root.task-move(t.id, root.col-index + 1); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "删除";
                                width: 40px; height: 22px; outlined: true;
                                clicked => { root.task-delete(t.id); }
                            }
                        }
                    }
                }
            }
        }
    }
}

component TaskPage {
    in property <[TaskRow]> tasks;
    in property <int> c0;
    in property <int> c1;
    in property <int> c2;
    in property <int> c3;
    in-out property <string> new-title;
    callback task-add(string);
    callback task-move(string, int);
    callback task-delete(string);

    // 四列视图：从快照按 col 过滤（本版 Slint 不支持 for+if 嵌套，用 Rust 下发四份列表更稳；
    // 这里退而用一份列表 + 每列本地过滤函数式的 selector 属性，交给 AppWindow 下发 col0..col3）
    in property <[TaskRow]> col0;
    in property <[TaskRow]> col1;
    in property <[TaskRow]> col2;
    in property <[TaskRow]> col3;

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        VerticalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            padding: 20px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 10px;
                StatCard { label: "待规划"; value: root.c0; tone: 0; }
                StatCard { label: "待办"; value: root.c1; tone: 1; }
                StatCard { label: "进行中"; value: root.c2; tone: 2; }
                StatCard { label: "已完成"; value: root.c3; tone: 3; }
            }

            // 新建任务条
            Rectangle {
                height: 48px;
                border-radius: 8px;
                background: Theme.palette.surface_raised;
                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;
                    Input {
                        placeholder-text: "新任务标题（回车或点添加）";
                        text <=> root.new-title;
                        height: 32px;
                        horizontal-stretch: 1;
                        accepted => { root.task-add(root.new-title); root.new-title = ""; }
                    }
                    Button {
                        text: "添加任务";
                        width: 92px; height: 32px;
                        clicked => { root.task-add(root.new-title); root.new-title = ""; }
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                vertical-stretch: 1;
                TaskColumn {
                    title: "待规划"; col-index: 0; tasks: root.col0;
                    task-move(id, c) => { root.task-move(id, c); }
                    task-delete(id) => { root.task-delete(id); }
                }
                TaskColumn {
                    title: "待办"; col-index: 1; tasks: root.col1;
                    task-move(id, c) => { root.task-move(id, c); }
                    task-delete(id) => { root.task-delete(id); }
                }
                TaskColumn {
                    title: "进行中"; col-index: 2; tasks: root.col2;
                    task-move(id, c) => { root.task-move(id, c); }
                    task-delete(id) => { root.task-delete(id); }
                }
                TaskColumn {
                    title: "已完成"; col-index: 3; tasks: root.col3;
                    task-move(id, c) => { root.task-move(id, c); }
                    task-delete(id) => { root.task-delete(id); }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// 页面：智能树（树包 / 四类群组）
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// 页面：工具面
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// 页面：知识 / 技能（空态 + 说明）
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// 页面：空间
// ---------------------------------------------------------------------------

/// 两档分段选择器：明确显示两项，当前项高亮（避免下拉框显示占位符）。
component Seg2 inherits Rectangle {
    in property <string> a-label;
    in property <string> b-label;
    /// true = 选中第二项
    in property <bool> b-selected: false;
    callback picked(bool);

    height: 26px;
    border-radius: 6px;
    background: Theme.palette.surface;
    border-width: 1px;
    border-color: Theme.palette.border;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        Rectangle {
            horizontal-stretch: 1;
            height: 100%;
            border-radius: 4px;
            background: !root.b-selected ? Theme.palette.primary : transparent;
            Text {
                text: root.a-label;
                color: !root.b-selected ? Theme.palette.on_primary : Theme.palette.text_secondary;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { clicked => { root.picked(false); } }
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 100%;
            border-radius: 4px;
            background: root.b-selected ? Theme.palette.primary : transparent;
            Text {
                text: root.b-label;
                color: root.b-selected ? Theme.palette.on_primary : Theme.palette.text_secondary;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { clicked => { root.picked(true); } }
        }
    }
}

component SpacePage {
    in property <[SpaceRow]> spaces;
    in property <[CapGroupRow]> groups;
    in property <[DomainGroupChip]> group-chips;
    in property <[SessionRow]> sessions;
    in-out property <string> new-name;
    in-out property <string> new-note;
    // 空间编辑表单（选中空间后回填）
    in-out property <string> edit-space;
    in-out property <string> edit-cwd;
    in-out property <string> edit-whitelist;
    in-out property <string> edit-permission;
    in-out property <string> edit-sandbox;
    in-out property <string> session-filter;

    callback switch-to(string);
    callback create();
    callback remove(string);
    callback space-save(string);
    callback space-pick(string);
    callback space-toggle-group(string);
    callback pick-dir(string);
    callback session-list(string);
    callback session-open(string);
    callback session-delete(string);
    callback session-export(string);
    callback session-recall(string);
    callback copy-message(string);

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        VerticalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            padding: 20px;
            spacing: 12px;

            Rectangle {
                height: 92px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.palette.border;
                background: Theme.palette.surface_raised;
                HorizontalLayout {
                    padding: 14px;
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 6px;
                        width: 200px;
                        Text { text: "新建空间"; color: Theme.palette.text_primary; font-size: 13px; font-weight: 600; }
                        Input {
                            placeholder-text: "空间名（字母数字-_ .）";
                            text <=> root.new-name;
                            height: 36px;
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Text { text: "说明"; color: Theme.palette.text_primary; font-size: 13px; font-weight: 600; }
                        Input {
                            placeholder-text: "这个空间用来做什么（可空）";
                            text <=> root.new-note;
                            height: 36px;
                        }
                    }
                    VerticalLayout {
                        width: 92px;
                        spacing: 6px;
                        Text { text: " "; font-size: 13px; }
                        Button {
                            text: "创建";
                            height: 36px;
                            clicked => { root.create(); }
                        }
                    }
                }
            }

            // 整页可滚动：空间列表不再抢占高度，编辑面板/会话面板不会被窗口底边裁切
            ScrollView {
                vertical-stretch: 1;
                content-width: self.width;
                VerticalLayout {
                    width: parent.width;
                    spacing: 12px;

                    Text {
                        text: "空间 = 独立目录 + 权限模式 + 沙箱开关 + 模型绑定 + 工具白名单 + 记忆。切换空间后新建会话生效。";
                        color: Theme.palette.text_secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                        min-height: 18px;
                    }

                    VerticalLayout {
                        spacing: 8px;
                        for s in root.spaces : Rectangle {
                        height: 58px;
                        border-radius: 8px;
                        border-width: s.active ? 2px : 1px;
                        border-color: s.active ? Theme.palette.primary : Theme.palette.border;
                        background: Theme.palette.surface_raised;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            VerticalLayout {
                                spacing: 2px;
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: s.name + (s.active ? "（当前）" : "");
                                    color: Theme.palette.text_primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: (s.permission == "unrestricted" ? "完全访问" : "默认全局")
                                        + " · 沙箱" + (s.sandbox == "on" ? "开" : "关")
                                        + " · 白名单 " + s.plugins + " 条"
                                        + (s.note == "" ? "" : " · " + s.note);
                                    color: Theme.palette.text_secondary;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                            Button {
                                text: "切换";
                                outlined: !s.active;
                                width: 60px;
                                height: 32px;
                                clicked => { root.switch-to(s.name); }
                            }
                            Button {
                                text: "编辑";
                                outlined: true;
                                width: 56px;
                                height: 32px;
                                clicked => {
                                    root.edit-space = s.name;
                                    root.edit-cwd = s.cwd;
                                    root.edit-whitelist = s.whitelist;
                                    root.edit-permission = s.permission;
                                    root.edit-sandbox = s.sandbox;
                                    root.space-pick(s.name);
                                    root.session-filter = s.name;
                                    root.session-list(s.name);
                                }
                            }
                            Button {
                                text: "移除";
                                outlined: true;
                                width: 56px;
                                height: 32px;
                                clicked => { root.remove(s.name); }
                            }
                        }
                    }
                    if root.spaces.length == 0 : Rectangle {
                        height: 120px;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "还没有空间：默认使用「全局」配置（exe 同级 config.toml）";
                                color: Theme.palette.text_disabled;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    }

            // 空间编辑面板（点"编辑"后出现）
            if root.edit-space != "" : Rectangle {
                // 高度随内容：固定高度会留大片空白并挤压控件
                height: edit-body.preferred-height + 24px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.palette.primary;
                background: Theme.palette.surface_raised;
                edit-body := VerticalLayout {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    spacing: 8px;

                    Text {
                        text: "编辑空间：" + root.edit-space;
                        color: Theme.palette.text_primary;
                        font-size: 12px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "目录 = shell/文件工具的工作落点；权限与沙箱在此单独设定，保存后新建会话生效。";
                        color: Theme.palette.text_disabled;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "本地目录"; width: 66px; color: Theme.palette.text_secondary; font-size: 11px; vertical-alignment: center; }
                        Input { text <=> root.edit-cwd; placeholder-text: "留空 = 程序数据目录"; height: 30px; horizontal-stretch: 1; }
                        Button { text: "浏览…"; width: 68px; height: 30px; outlined: true; clicked => { root.pick-dir("space-cwd"); } }
                    }

                    // 工具组白名单整行独占：避免与其它列对半分导致挤压/错位
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "工具组白名单（点选授权；0 组 = 全部）；下方可手输精确工具名";
                            color: Theme.palette.text_secondary;
                            font-size: 11px;
                            overflow: elide;
                        }
                        chips-flow := FlexboxLayout {
                            width: parent.width;
                            spacing: 4px;
                            spacing-vertical: 4px;
                            flex-wrap: wrap;
                            alignment: start;
                            for g in root.group-chips : Rectangle {
                                height: 22px;
                                min-width: 54px;
                                border-radius: 11px;
                                background: g.declared ? Theme.palette.primary : Theme.palette.surface;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: g.label;
                                        color: g.declared ? Theme.palette.on_primary : Theme.palette.text_secondary;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.space-toggle-group(g.id); } }
                            }
                        }
                        TextEdit { text <=> root.edit-whitelist; height: 40px; wrap: word-wrap; }
                    }

                    // 权限 / 沙箱：两档分段选择（不再用会显示 Search... 的下拉框）
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "权限"; width: 36px; color: Theme.palette.text_secondary; font-size: 11px; vertical-alignment: center; }
                        Seg2 {
                            a-label: "默认全局";
                            b-label: "允许完全访问";
                            b-selected: root.edit-permission == "unrestricted";
                            picked(b) => { root.edit-permission = b ? "unrestricted" : "global"; }
                            width: 196px;
                        }
                        Text { text: "沙箱"; width: 36px; color: Theme.palette.text_secondary; font-size: 11px; vertical-alignment: center; }
                        Seg2 {
                            a-label: "关闭";
                            b-label: "启用";
                            b-selected: root.edit-sandbox == "on";
                            picked(b) => { root.edit-sandbox = b ? "on" : "off"; }
                            width: 132px;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "保存空间"; width: 92px; height: 30px;
                            clicked => { root.space-save(root.edit-space); }
                        }
                    }
                }
            }

            // 会话管理（选中空间后列出该空间的会话）
            if root.edit-space != "" : Rectangle {
                // 外层已可滚动，这里用最小高度而非 stretch（stretch 会被压成 0）
                min-height: 200px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.palette.border;
                background: Theme.palette.surface_raised;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    HorizontalLayout {
                        Text { text: "会话（" + root.edit-space + "）"; color: Theme.palette.text_primary; font-size: 12px; font-weight: 600; }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "刷新"; width: 56px; height: 26px; outlined: true; clicked => { root.session-list(root.edit-space); } }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        content-width: self.width;
                        VerticalLayout {
                            spacing: 5px;
                            for s in root.sessions : Rectangle {
                                height: 40px;
                                border-radius: 6px;
                                background: Theme.palette.surface;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 6px;
                                    VerticalLayout { horizontal-stretch: 1; spacing: 1px;
                                        Text { text: s.preview; color: Theme.palette.text_primary; font-size: 11px; overflow: elide; }
                                        Text { text: s.turns + " 轮 · " + s.updated; color: Theme.palette.text_disabled; font-size: 10px; }
                                    }
                                    Button { text: "打开"; width: 44px; height: 24px; outlined: true; clicked => { root.session-open(s.id); } }
                                    Button { text: "召回"; width: 44px; height: 24px; outlined: true; clicked => { root.session-recall(s.id); } }
                                    Button { text: "导出"; width: 44px; height: 24px; outlined: true; clicked => { root.session-export(s.id); } }
                                    Button { text: "复制"; width: 44px; height: 24px; outlined: true; clicked => { root.copy-message(s.preview); } }
                                    Button { text: "删除"; width: 44px; height: 24px; outlined: true; clicked => { root.session-delete(s.id); } }
                                }
                            }
                            if root.sessions.length == 0 : Text {
                                text: "该空间暂无会话";
                                color: Theme.palette.text_disabled;
                                font-size: 11px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// 页面：会话（一级菜单）
// 按空间分类显示历史会话：左侧空间筛选，中间会话列表，右侧预览。
// 「预览」= 只在右侧看这条会话，不动当前对话；「继续此会话」才真正切换；「召回」= 把旧会话摘要注入当前会话。
// ---------------------------------------------------------------------------

component SessionPage {
    in property <[SpaceRow]> spaces;
    in property <[SessionRow]> sessions;
    in-out property <string> filter: "";
    // 预览（不动当前对话）：点「预览」只在右侧看这条会话，切会话必须显式点「继续此会话」
    in property <[ChatMsg]> view;
    in property <string> view-title: "";
    in property <string> view-meta: "";
    in-out property <string> view-id: "";
    callback list(string);
    callback view-session(string);
    callback open(string);
    callback recall(string);
    callback delete(string);
    callback export(string);
    callback new-session();

    HorizontalLayout {
        spacing: 12px;
        // 左侧：空间分类
        Rectangle {
            width: 180px;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.palette.border;
            background: Theme.palette.surface_raised;
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                Text { text: "按空间分类"; color: Theme.palette.text_primary; font-size: 12px; font-weight: 600; height: 22px; }
                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;
                    VerticalLayout {
                        spacing: 4px;
                        Rectangle {
                            height: 30px;
                            border-radius: 5px;
                            background: root.filter == "" ? Theme.palette.primary : (ta-all.has-hover ? Theme.palette.hover_overlay : Colors.transparent);
                            HorizontalLayout { padding-left: 8px;
                                Text { text: "全部会话"; color: root.filter == "" ? Theme.palette.on_primary : Theme.palette.text_primary; font-size: 11px; vertical-alignment: center; }
                            }
                            ta-all := TouchArea { clicked => { root.filter = ""; root.list(""); } }
                        }
                        for s in root.spaces : Rectangle {
                            height: 30px;
                            border-radius: 5px;
                            background: root.filter == s.name ? Theme.palette.primary : (ta-s.has-hover ? Theme.palette.hover_overlay : Colors.transparent);
                            HorizontalLayout { padding-left: 8px;
                                Text { text: s.name; color: root.filter == s.name ? Theme.palette.on_primary : Theme.palette.text_primary; font-size: 11px; vertical-alignment: center; overflow: elide; }
                            }
                            ta-s := TouchArea { clicked => { root.filter = s.name; root.list(s.name); } }
                        }
                    }
                }
            }
        }
        // 右侧：会话列表
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.palette.border;
            background: Theme.palette.surface_raised;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                HorizontalLayout {
                    Text { text: root.filter == "" ? "全部会话" : ("会话（" + root.filter + "）"); color: Theme.palette.text_primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "刷新"; width: 56px; height: 26px; outlined: true; clicked => { root.list(root.filter); } }
                    Button { text: "+ 新对话"; width: 76px; height: 26px; clicked => { root.new-session(); } }
                }
                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;
                    VerticalLayout {
                        spacing: 5px;
                        for s in root.sessions : Rectangle {
                            height: 44px;
                            border-radius: 6px;
                            background: root.view-id == s.id ? Theme.palette.surface_raised : Theme.palette.surface;
                            // 整行可点 = 预览（不覆盖当前对话）；放在按钮之前，按钮仍优先接收点击
                            ta-row := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.view-id = s.id; root.view-session(s.id); }
                            }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 6px;
                                VerticalLayout { horizontal-stretch: 1; spacing: 1px;
                                    Text { text: s.preview; color: Theme.palette.text_primary; font-size: 11px; overflow: elide; }
                                    Text { text: s.turns + " 轮 · " + s.updated + (s.space == "" ? " · 全局" : " · " + s.space); color: Theme.palette.text_disabled; font-size: 10px; }
                                }
                                Button { text: "预览"; width: 44px; height: 24px; clicked => { root.view-id = s.id; root.view-session(s.id); } }
                                Button { text: "召回"; width: 44px; height: 24px; outlined: true; clicked => { root.recall(s.id); } }
                                Button { text: "导出"; width: 44px; height: 24px; outlined: true; clicked => { root.export(s.id); } }
                                Button { text: "删除"; width: 44px; height: 24px; outlined: true; clicked => { root.delete(s.id); } }
                            }
                        }
                        if root.sessions.length == 0 : Text {
                            text: "该空间暂无会话，点「刷新」加载";
                            color: Theme.palette.text_disabled;
                            font-size: 11px;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
        // 右侧：预览面板（只读展示，不覆盖当前对话）
        if root.view-id != "" : Rectangle {
            width: 320px;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.palette.border;
            background: Theme.palette.surface_raised;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Text { text: root.view-title == "" ? "会话预览" : root.view-title; color: Theme.palette.text_primary; font-size: 12px; font-weight: 600; wrap: word-wrap; }
                Text { text: root.view-meta; color: Theme.palette.text_disabled; font-size: 10px; }
                Rectangle { height: 1px; background: Theme.palette.border; }
                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;
                    VerticalLayout {
                        spacing: 6px;
                        for m in root.view : Rectangle {
                            // 高度由内容撑开：气泡长短差异大，写死高度会截断
                            height: lrow.preferred-height;
                            border-radius: 5px;
                            background: m.role == "user" ? Theme.palette.surface : Colors.transparent;
                            lrow := HorizontalLayout {
                                padding: 6px;
                                spacing: 6px;
                                Text { text: m.role == "user" ? "我" : (m.role == "system" ? "系统" : "AI"); color: m.role == "user" ? Theme.palette.primary : Theme.palette.text_disabled; font-size: 10px; width: 26px; vertical-alignment: top; }
                                Text { text: m.text; color: Theme.palette.text_secondary; font-size: 10px; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
                if root.view.length == 0 : Text {
                    text: "（这条会话没有可显示的消息）";
                    color: Theme.palette.text_disabled;
                    font-size: 10px;
                }
                HorizontalLayout {
                    spacing: 6px;
                    Button { text: "继续此会话"; height: 26px; horizontal-stretch: 1; clicked => { root.open(root.view-id); } }
                    Button { text: "关闭预览"; height: 26px; width: 84px; outlined: true; clicked => { root.view-id = ""; } }
                }
                Text {
                    text: "「继续此会话」才会替换当前对话；预览本身不改动任何会话。";
                    color: Theme.palette.text_disabled;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// 页面：记忆
// ---------------------------------------------------------------------------

component MemoryPage {
    in property <[DayRow]> days;
    in property <string> curated;
    in property <string> daily-date;
    in property <string> daily-text;
    in property <string> space-name;

    callback load(string);
    callback append-daily(string);

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        VerticalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            padding: 20px;
            spacing: 10px;

            Text {
                text: root.space-name == ""
                    ? "无活跃空间：记忆按空间隔离，请先在「空间」页切换或创建空间"
                    : "空间 " + root.space-name + " 的记忆（daily 追加日志 / curated 精炼笔记）";
                color: Theme.palette.text_secondary;
                font-size: 12px;
            }

            // 嵌套布局在 VerticalLayout 里不会横向拉伸（实测被压成首选宽 455px），
            // 所以这里不用布局，直接用显式 x/y/width/height 摆两张卡片。
            Rectangle {
                vertical-stretch: 1;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: 200px;
                    height: parent.height;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.palette.border;
                    background: Theme.palette.surface_raised;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        Text {
                            text: "每日日志";
                            color: Theme.palette.text_secondary;
                            font-size: 11px;
                            height: 22px;
                            vertical-alignment: center;
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            content-width: self.width;
                            VerticalLayout {
                                spacing: 2px;
                                for d in root.days : Rectangle {
                                    height: 28px;
                                    border-radius: 4px;
                                    background: (root.daily-date == d.date) ? Theme.palette.hover_overlay
                                              : (d-ta.has-hover ? Theme.palette.hover_overlay : Colors.transparent);
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: d.date;
                                            color: Theme.palette.text_primary;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: d.chars + " 字";
                                            color: Theme.palette.text_disabled;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    d-ta := TouchArea {
                                        clicked => { root.load(d.date); }
                                    }
                                }
                                if root.days.length == 0 : Text {
                                    text: "暂无日志";
                                    color: Theme.palette.text_disabled;
                                    font-size: 11px;
                                }
                            }
                        }
                        // 写入口放在 daily 卡片里：它写的确实是每日日志，
                        // 放在右侧 curated 卡片下会让人以为写精炼笔记。
                        Button {
                            text: "把对话要点写入今日";
                            height: 32px;
                            clicked => { root.append-daily(""); }
                        }
                    }
                }

                Rectangle {
                    x: 212px;
                    y: 0;
                    width: parent.width - 212px;
                    height: parent.height;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.palette.border;
                    background: Theme.palette.surface_raised;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Text {
                            text: root.daily-date == "" ? "精炼笔记 MEMORY.md（每空间 ≤3000 字）" : "日志 " + root.daily-date;
                            color: Theme.palette.text_secondary;
                            font-size: 11px;
                        }
                        Text {
                            text: root.daily-date == "" ? (root.curated == "" ? "（空）" : root.curated) : root.daily-text;
                            color: Theme.palette.text_primary;
                            font-size: 12px;
                            wrap: word-wrap;
                            vertical-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// 页面：模型
// ---------------------------------------------------------------------------

component ModelPage {
    in property <[ModelRow]> models;
    in property <string> active-name;

    callback use(string);
    callback test(string);

    // ---- 档案编辑（P0-6）：新增/编辑/删除都直接写 config.toml ----
    in-out property <bool> ed-open: false;
    in-out property <bool> ed-new: true;
    in-out property <string> ed-name: "";
    in-out property <string> ed-driver: "openai";
    in-out property <string> ed-url: "";
    in-out property <string> ed-model: "";
    in-out property <string> ed-key: "";
    in-out property <string> ed-ctx: "32000";
    in-out property <bool> ed-tools: true;
    in-out property <bool> ed-vision: false;
    in-out property <bool> ed-enabled: true;
    callback new-model();
    callback edit-model(string);
    callback save-model();
    callback delete-model(string);

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        VerticalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            padding: 20px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "模型档案（OpenAI 兼容协议）。能力字段决定工具面与上下文预算：不支持 function calling 的档案不下发工具。";
                    color: Theme.palette.text_secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "新增模型";
                    width: 96px;
                    height: 30px;
                    clicked => { root.new-model(); }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                content-width: self.width;
                VerticalLayout {
                    spacing: 8px;
                    for m in root.models : Rectangle {
                        height: 72px;
                        border-radius: 8px;
                        border-width: m.active ? 2px : 1px;
                        border-color: m.active ? Theme.palette.primary : Theme.palette.border;
                        background: Theme.palette.surface_raised;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            VerticalLayout {
                                spacing: 4px;
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: m.name + (m.active ? "　● 生效中" : "");
                                    color: Theme.palette.text_primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: m.model + " · " + m.ctx + " tok";
                                    color: Theme.palette.text_secondary;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                            Badge {
                                text: m.tools-ok ? "工具" : "无工具";
                                status: m.tools-ok ? BadgeStatus.success : BadgeStatus.warning;
                            }
                            Button {
                                text: "测连通";
                                outlined: true;
                                width: 80px;
                                height: 32px;
                                clicked => { root.test(m.name); }
                            }
                            Button {
                                text: m.active ? "使用中" : "启用";
                                disabled: m.active;
                                width: 72px;
                                height: 32px;
                                clicked => { root.use(m.name); }
                            }
                            Button {
                                text: "编辑";
                                outlined: true;
                                width: 60px;
                                height: 32px;
                                clicked => { root.edit-model(m.name); }
                            }
                            Button {
                                text: "删除";
                                outlined: true;
                                width: 60px;
                                height: 32px;
                                clicked => { root.delete-model(m.name); }
                            }
                        }
                    }
                    if root.models.length == 0 : Rectangle {
                        height: 140px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text {
                                text: "还没有模型档案";
                                color: Theme.palette.text_primary;
                                font-size: 14px;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "在 config.toml 的 [[llm.profiles]] 里添加，或点「打开配置文件」按示例填写";
                                color: Theme.palette.text_disabled;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }



        }

        // ---- 档案编辑面板（P0-6）：覆盖在页面底部，不挤压列表 ----
        if root.ed-open : Rectangle {
            x: 0;
            y: parent.height - 336px;
            width: parent.width;
            height: 336px;
            background: Theme.palette.surface_raised;
            border-color: Theme.palette.primary;
            border-width: 1px;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                Text {
                    text: root.ed-new ? "新增模型档案" : "编辑 " + root.ed-name;
                    color: Theme.palette.text_primary;
                    font-size: 13px;
                    font-weight: 600;
                    height: 22px;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Input { label: "档案名（唯一）"; text <=> root.ed-name; horizontal-stretch: 1; }
                    Input { label: "driver（openai / anthropic / gemini）"; text <=> root.ed-driver; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Input { label: "base_url"; text <=> root.ed-url; horizontal-stretch: 2; }
                    Input { label: "模型名"; text <=> root.ed-model; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Input { label: "API Key（留空 = 不修改）"; text <=> root.ed-key; horizontal-stretch: 3; }
                    Input { label: "上下文 tokens"; text <=> root.ed-ctx; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 18px;
                    height: 28px;
                    CheckBox { text: "支持 function calling"; checked <=> root.ed-tools; }
                    CheckBox { text: "支持视觉"; checked <=> root.ed-vision; }
                    CheckBox { text: "启用"; checked <=> root.ed-enabled; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    height: 32px;
                    Button {
                        text: "保存";
                        width: 88px;
                        height: 32px;
                        clicked => { root.save-model(); }
                    }
                    Button {
                        text: "取消";
                        outlined: true;
                        width: 88px;
                        height: 32px;
                        clicked => { root.ed-open = false; }
                    }
                    Text {
                        text: parent.width > 0 ? "保存后写入 config.toml 并重新装配（新档案立即生效）" : "";
                        color: Theme.palette.text_disabled;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// 页面：设置
// ---------------------------------------------------------------------------

component RightRail {
    in property <[TraceRow]> traces;
    // 轨迹条数变化触发自动滚屏
    property <int> trace-count: root.traces.length;
    in property <[TaskRow]> tasks;
    in property <string> status-line;
    in property <int> tool-count;
    in property <float> ctx-ratio;
    in property <int> ctx-window;

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        VerticalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            padding: 12px;
            spacing: 10px;

            Text { text: "运行看板"; color: Theme.palette.text_primary; font-size: 13px; font-weight: 600; height: 24px; vertical-alignment: center; }

            Rectangle {
                height: 96px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.palette.border;
                background: Theme.palette.surface_raised;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    Text { text: "上下文预算"; color: Theme.palette.text_secondary; font-size: 11px; }
                    ProgressBar { progress: root.ctx-ratio; }
                    Text {
                        text: "窗口 " + root.ctx-window + " tok · 已用 " + round(root.ctx-ratio * 100) + "%";
                        color: Theme.palette.text_disabled;
                        font-size: 10px;
                    }
                }
            }

            Text { text: "过程轨迹"; color: Theme.palette.text_secondary; font-size: 11px; height: 20px; vertical-alignment: center; }

            Rectangle {
                vertical-stretch: 1;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.palette.border;
                background: Theme.palette.surface_raised;
                clip: true;
                ScrollView {
                    content-width: self.width;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        for t in root.traces : Rectangle {
                            // 行高随内容自适应：缩放/折行后不再截断重叠（原来固定 26/46px）
                            height: max(26px, title-t.preferred-height + 4px);
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                TraceIcon { status: t.status; }
                                title-t := Text {
                                    text: t.title;
                                    color: Theme.palette.text_secondary;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        if root.traces.length == 0 : Text {
                            text: "尚无轨迹";
                            color: Theme.palette.text_disabled;
                            font-size: 11px;
                        }
                        // 哨兵：轨迹变化后滚到最新
                        trace-tail := Rectangle { height: 1px; }
                    }
                }
            }

            Text {
                text: root.status-line;
                color: Theme.palette.text_disabled;
                font-size: 10px;
                wrap: word-wrap;
                height: 30px;
            }
        }
    }

    trace-scroll-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            trace-tail.ensure-visible(ScrollBehavior.instant);
            self.running = false;
        }
    }
    changed trace-count => { trace-scroll-timer.running = true; }
}


// ---------------------------------------------------------------------------
// 页面：内置能力配置（卡片由配置元数据驱动，新增参数不改界面代码）
// ---------------------------------------------------------------------------

export struct CfgItem {
    key: string,
    label: string,
    help: string,
    /// bool | int | float | text | secret | path | enum | list
    kind: string,
    value: string,
    options: [string],
    restart: bool,
    /// 路径字段：true=选目录，false=选文件（python/pip 可执行文件）
    path-is-dir: bool,
}

export struct CfgCard {
    id: string,
    title: string,
    desc: string,
    /// 归属配置二级页：model | capability | security | data | domain
    page: string,
    items: [CfgItem],
}

/// 知识库只读行（领域页「知识管理」）：类型｜存储位置｜用途｜条目数
export struct KbStoreRow {
    kind: string,
    label: string,
    location: string,
    purpose: string,
    entries: int,
    error: string,
}

/// 领域页的一行：列表 + 组引用 + 工具面预览都从这里来。
/// 领域私有外部工具的一行（`domain.toml` 的 `[[external]]`）。
///
/// 它**不属于插件体系**：没有安装/卸载/组，领域目录在就在，删掉就没。
export struct DomainExtRow {
    /// 声明下标（移除时用）
    index: int,
    /// exe / declarative
    kind: string,
    name: string,
    /// 声明里的路径原文
    path: string,
    usage: string,
    /// 文件/目录是否真的在
    exists: bool,
    /// 产出的工具名（`namespace.action`）
    tools: [string],
    /// 不可用原因（空 = 正常）
    error: string,
}

export struct DomainCardRow {
    id: string,
    name: string,
    kind: string,
    summary: string,
    /// 声明的组 id（未命中基座组的会在界面上标灰）
    groups: [string],
    tools: int,
    knowledge-entries: int,
    /// 该领域声明的知识库（只读）
    kb: [KbStoreRow],
    /// 该领域私有的外部工具（`[[external]]`）
    external: [DomainExtRow],
    has-workflow: bool,
    active: bool,
    error: string,
}

component CfgRow inherits Rectangle {
    in property <CfgItem> item;
    callback field-edited(string, string);
    // 文本逐字草稿：只改内存，点「保存配置」才落盘（避免逐键校验/弹警告）
    callback field-draft(string, string);
    callback pick-path(string, bool);  // key, is-dir —— 浏览选择路径（#13.1/#16）

    // 高度按控件类型给足：
    //   list  = 多行文本
    //   bool  = 一行
    //   action / pick = 多行按钮网格（候选项可达十几个，单行会溢出成不可点的截断）
    height: item.kind == "list" ? 118px
          : (item.kind == "bool" ? 48px
          : (item.kind == "action" ? 128px
          : (item.kind == "pick" ? 96px
          : (item.kind == "slider" ? 62px : 70px))));
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 3px;

        HorizontalLayout {
            spacing: 10px;
            Text {
                text: item.label;
                width: 170px;
                color: Theme.palette.text_primary;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            if item.kind == "bool" : CheckBox {
                text: item.value == "true" ? "已开启" : "已关闭";
                checked: item.value == "true";
                toggled => {
                    field-edited(item.key, item.value == "true" ? "false" : "true");
                }
            }
            // 枚举：就地一排按钮，当前值高亮。比下拉弹层少一次点击，也不受弹层行数限制。
            if item.kind == "enum" : HorizontalLayout {
                spacing: 6px;
                for opt in item.options : Button {
                    text: opt;
                    height: 28px;
                    outlined: item.value != opt;
                    clicked => { field-edited(item.key, opt); }
                }
            }
            // 动态候选（领域列表 / 模型预设 / 已有档案）：按钮网格。
            // 为什么不用 ComboBox：本版 Slint 的弹层一次只显示 6 行，16 个预设里
            // 还有一半点不到。网格虽占地方，但每一项都可见可点。
            if item.kind == "pick" || item.kind == "action" : VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                // 第 1 行
                HorizontalLayout {
                    spacing: 4px;
                    for opt[i] in item.options : Button {
                        visible: i < 8;
                        text: opt;
                        height: 28px;
                        outlined: item.kind == "action" || item.value != opt;
                        clicked => { field-edited(item.key, opt); }
                    }
                }
                // 第 2 行（pick 只留两行；action 最多三行）
                HorizontalLayout {
                    spacing: 4px;
                    for opt[i] in item.options : Button {
                        visible: i >= 8 && i < 16;
                        text: opt;
                        height: 28px;
                        outlined: true;
                        clicked => { field-edited(item.key, opt); }
                    }
                }
                if item.kind == "action" : HorizontalLayout {
                    spacing: 4px;
                    for opt[i] in item.options : Button {
                        visible: i >= 16;
                        text: opt;
                        height: 28px;
                        outlined: true;
                        clicked => { field-edited(item.key, opt); }
                    }
                }
            }
            // #13 字号滑杆：options[0]=min / options[1]=max，拖动即提交整数值
            if item.kind == "slider" : Slider {
                value: item.value.to-float();
                min: item.options.length > 0 ? item.options[0].to-float() : 10;
                max: item.options.length > 1 ? item.options[1].to-float() : 24;
                horizontal-stretch: 1;
                changed(v) => { field-edited(item.key, Math.round(v)); }
            }
            // 文本输入：逐字进内存草稿，点「保存配置」统一落盘；回车也直接提交。
            // 逐键写盘会让每个字符都跑一次校验并弹诊断，正是"改输入框就弹警告"的根因。
            if item.kind != "bool" && item.kind != "enum"
               && item.kind != "list" && item.kind != "pick"
               && item.kind != "action" && item.kind != "path"
               && item.kind != "slider" : LineEdit {
                text: item.value;
                placeholder-text: item.kind == "secret" ? "未设置" : "";
                horizontal-stretch: 1;
                height: 30px;
                edited(t) => { field-draft(item.key, t); }
                accepted(t) => { field-edited(item.key, t); }
            }
            // #16/#13.1：路径字段用"输入框 + 浏览…"，不再手输
            if item.kind == "path" : HorizontalLayout {
                spacing: 6px;
                LineEdit {
                    text: item.value;
                    horizontal-stretch: 1;
                    height: 30px;
                    edited(t) => { field-draft(item.key, t); }
                    accepted(t) => { field-edited(item.key, t); }
                }
                Button {
                    text: "浏览…";
                    width: 66px;
                    height: 30px;
                    outlined: true;
                    clicked => { root.pick-path(item.key, item.path-is-dir); }
                }
            }
            if item.kind == "list" : TextEdit {
                text: item.value;
                horizontal-stretch: 1;
                height: 64px;
                wrap: word-wrap;
                // 同文本输入：逐字进草稿，点「保存配置」统一落盘
                edited(t) => { field-draft(item.key, t); }
            }
        }
        Text {
            text: item.help;
            color: Theme.palette.text_disabled;
            font-size: 10px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

component CfgCardView inherits Rectangle {
    in property <CfgCard> card;
    callback field-edited(string, string);
    callback field-draft(string, string);
    callback pick-path(string, bool);

    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.palette.border;
    background: Theme.palette.surface;
    // 高度由内容决定（卡片纵向排列）
    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        Rectangle {
            height: 46px;
            background: Theme.palette.surface_raised;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 6px;
                spacing: 1px;
                Text {
                    text: card.title;
                    color: Theme.palette.text_primary;
                    font-size: 13px;
                    font-weight: 600;
                }
                Text {
                    text: card.desc;
                    color: Theme.palette.text_disabled;
                    font-size: 10px;
                    overflow: elide;
                }
            }
        }
        for it in card.items : CfgRow {
            item: it;
            field-edited(k, v) => { root.field-edited(k, v); }
            field-draft(k, v) => { root.field-draft(k, v); }
            pick-path(k, d) => { root.pick-path(k, d); }
        }
    }
}

component ConfigPage inherits Rectangle {
    in property <[CfgCard]> cards;
    in property <string> note;
    callback field-edited(string, string);
    callback field-draft(string, string);
    callback save-config();
    callback pick-path(string, bool);

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        VerticalLayout {
            spacing: 0px;
            // 说明条：所有参数都在这里改，配置文件只是高级通道
            Rectangle {
                height: 38px;
                background: Theme.palette.surface_raised;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    Text {
                        text: "参数在下面卡片里修改；文本/列表改完点「保存配置」落盘，开关/按钮即时生效。";
                        color: Theme.palette.text_secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: note;
                        color: Theme.palette.text_primary;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Button {
                        text: "保存配置";
                        width: 84px;
                        height: 28px;
                        clicked => { root.save-config(); }
                    }
                }
            }
            Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: body.preferred-height;
                body := VerticalLayout {
                    width: parent.width;
                    padding: 16px;
                    spacing: 12px;
                    for c in cards : CfgCardView {
                        card: c;
                        field-edited(k, v) => { root.field-edited(k, v); }
                        field-draft(k, v) => { root.field-draft(k, v); }
                        pick-path(k, d) => { root.pick-path(k, d); }
                    }
                    Rectangle { height: 8px; }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// 主窗口
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// 页面：领域（列表 / 组引用 / 工具面预览 / 文件预览）
//
// 领域的职责是"决定这套工具面干什么用"。所以这一页必须能同时看到
// ① 有哪些领域 ② 这个领域引用了哪些组 ③ 装配出来多少个工具 ④ 四个文件在不在。
// 只看一个下拉框等于只能"切"不能"判断"。
// ---------------------------------------------------------------------------
component DomainPage inherits Rectangle {
    in property <[DomainCardRow]> domains;
    // 领域级参数（卡片由配置元数据驱动，page == "domain" 的那张）
    in property <[CfgCard]> cards;
    in property <string> note;
    in-out property <int> sel: 0;
    callback switch-to(string);
    callback field-edited(string, string);

    // 组↔领域绑定（可点选）：chips 由 Rust 按"选中领域"下发，勾选只改内存，保存才写文件
    in property <[DomainGroupChip]> group-chips;
    in property <bool> groups-dirty: false;
    callback pick-domain(int);
    callback toggle-group(string);
    callback save-groups();
    // 领域 CRUD + 文件编辑 + 知识管理（#7.1/#7.2）
    in-out property <string> new-domain-id;
    in-out property <string> new-domain-name;
    in property <[KnowledgeRow]> knowledge;
    in-out property <string> knowledge-name;
    in-out property <string> knowledge-text;
    in-out property <string> dom-file-name;
    in-out property <string> dom-file-text;
    callback domain-create(string, string);
    callback domain-remove(string);
    callback domain-file-read(string, string);
    callback domain-file-save(string, string, string);
    callback knowledge-add(string, string);
    callback knowledge-remove(string);
    // 领域私有外部工具（`[[external]]`）：加 exe / 加声明式目录 / 移除（按下标）
    in-out property <string> ext-usage;
    callback ext-add-exe();
    callback ext-add-dir();
    callback ext-remove(int);
    // 领域概要编辑（≤300 字）与 AI 生成四份配置
    in-out property <string> dom-summary;
    in-out property <int> dom-summary-len: 0;
    in-out property <bool> ai-busy: false;
    callback save-summary(string, string);
    callback ai-generate(string);
    callback summary-edited();
    // 领域列表一到位就自动选中第一个，让 Rust 下发组 chips（不依赖启动时序）。
    // 之后刷新列表（保存概要/AI 生成/增删知识）不再把选中项弹回第一个——
    // 否则用户刚生成完一个领域，视线就被拽走了。
    in-out property <bool> init-picked: false;
    changed domains => {
        if (self.domains.length > 0 && (!self.init-picked || self.sel >= self.domains.length)) {
            self.init-picked = true;
            self.sel = 0;
            self.pick-domain(0);
        }
        root.dom-summary = root.cur.summary;
        root.summary-edited();
    }
    // 切换领域时把概要框灌成该领域的当前概要（用户改了没保存就切换 = 丢弃改动）
    changed sel => {
        root.dom-summary = root.cur.summary;
        root.summary-edited();
    }

    property <bool> has: domains.length > 0;
    property <DomainCardRow> cur: (has && sel >= 0 && sel < domains.length) ? domains[sel] : {};

    HorizontalLayout {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        // ---- 左：领域列表 ----
        Rectangle {
            width: 268px;
            background: Theme.palette.surface;
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                Text {
                    text: "领域（" + domains.length + "）";
                    color: Theme.palette.text_disabled;
                    font-size: 11px;
                    height: 22px;
                    vertical-alignment: center;
                }
                Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: dlist.preferred-height;
                    dlist := VerticalLayout {
                        width: parent.width;
                        spacing: 2px;
                        for d[i] in domains : Rectangle {
                            height: 58px;
                            border-radius: 6px;
                            background: root.sel == i ? Theme.palette.surface_raised
                                      : (dta.has-hover ? Theme.palette.hover_overlay : Colors.transparent);
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                padding-top: 7px;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: d.name;
                                        color: Theme.palette.text_primary;
                                        font-size: 12px;
                                        font-weight: root.sel == i ? 600 : 400;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    if d.active : Text {
                                        text: "●";
                                        color: Theme.palette.success;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                    if d.error != "" : Text {
                                        text: "!";
                                        color: Theme.palette.critical;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: d.id + " · 组 " + d.groups.length + " · 工具 " + d.tools;
                                    color: Theme.palette.text_disabled;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }
                            dta := TouchArea {
                                x: 0;
                                y: 0;
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.sel = i;
                                    root.pick-domain(i);
                                }
                            }
                        }
                    }
                }
                // 新建领域（#7.1）：按 default 模板创建四文件
                Rectangle {
                    height: 88px;
                    border-radius: 6px;
                    background: Theme.palette.surface_raised;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Text { text: "新建领域（按 default 模板）"; color: Theme.palette.text_secondary; font-size: 11px; }
                        Input { placeholder-text: "id（字母数字_-）"; text <=> root.new-domain-id; height: 26px; }
                        Input { placeholder-text: "名称"; text <=> root.new-domain-name; height: 26px; }
                        HorizontalLayout { spacing: 4px;
                            Button { text: "创建"; height: 24px; horizontal-stretch: 1;
                                clicked => { root.domain-create(root.new-domain-id, root.new-domain-name); root.new-domain-id = ""; root.new-domain-name = ""; } }
                            Button { text: "删除当前"; height: 24px; horizontal-stretch: 1; outlined: true;
                                clicked => { if root.has { root.domain-remove(root.cur.id); } } }
                        }
                    }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.palette.border; }

        // ---- 右：详情 ----
        if !root.has : Rectangle {
            horizontal-stretch: 1;
            Text {
                text: "domains/ 下没有可用的领域目录（首次启动会自动落一份 default 模板）";
                color: Theme.palette.text_disabled;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if root.has : VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            // ---- 上半：信息区（可滚动，占满文件编辑器以外的空间）----
            Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: detail.preferred-height;
                detail := VerticalLayout {
                    width: parent.width;
                    padding: 18px;
                    spacing: 12px;

                    // 标题
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: root.cur.name + "  (" + root.cur.id + ")";
                                color: Theme.palette.text_primary;
                                font-size: 16px;
                                font-weight: 600;
                            }
                            Text {
                                text: root.cur.kind + " · 知识 " + root.cur.knowledge-entries + " 条"
                                    + (root.cur.has-workflow ? " · 有工作范式" : " · 无工作范式");
                                color: Theme.palette.text_secondary;
                                font-size: 11px;
                            }
                        }
                        if root.cur.active : Badge {
                            text: "当前领域";
                            status: BadgeStatus.success;
                        }
                        if !root.cur.active && root.cur.error == "" : Button {
                            text: "切换到此领域";
                            width: 108px;
                            height: 30px;
                            clicked => { root.switch-to(root.cur.id); }
                        }
                    }

                    if root.cur.error != "" : Rectangle {
                        height: 44px;
                        border-radius: 6px;
                        background: Theme.palette.surface_raised;
                        border-width: 1px;
                        border-color: Theme.palette.critical;
                        Text {
                            x: 10px;
                            y: 0px;
                            width: parent.width - 20px;
                            height: parent.height;
                            text: "装载失败：" + root.cur.error;
                            color: Theme.palette.critical;
                            font-size: 11px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }

                    // 领域概要（≤300 字）+ AI 生成领域配置
                    Rectangle {
                        height: 146px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.palette.border;
                        background: Theme.palette.surface_raised;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "领域概要（写清这个领域解决什么问题、面向什么对象）";
                                    color: Theme.palette.text_primary;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    // Slint 的 string 没有 .length：字数由 Rust 侧算好下发
                                    text: root.dom-summary-len + "/300";
                                    color: root.dom-summary-len > 300 ? Theme.palette.critical : Theme.palette.text_disabled;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }
                            TextEdit {
                                text <=> root.dom-summary;
                                height: 58px;
                                wrap: word-wrap;
                                font-size: 11px;
                                edited => { root.summary-edited(); }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    text: "保存概要";
                                    width: 84px;
                                    height: 24px;
                                    clicked => {
                                        // 超 300 字不提交（后端也会拒，这里先拦一次，避免白跑一趟）
                                        if (root.dom-summary-len <= 300) { root.save-summary(root.cur.id, root.dom-summary); }
                                    }
                                }
                                Button {
                                    text: root.ai-busy ? "生成中…" : "AI 生成领域配置";
                                    width: 132px;
                                    height: 24px;
                                    outlined: true;
                                    clicked => {
                                        if (!root.ai-busy && root.dom-summary-len > 0 && root.dom-summary-len <= 300) {
                                            root.ai-generate(root.cur.id);
                                        }
                                    }
                                }
                                Text {
                                    text: "按概要生成 domain.toml / workflow.md / knowledge.md / constraints.toml（原文件先备份 .bak）";
                                    color: Theme.palette.text_disabled;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // 组引用（可点选：亮 = 已引用，点击切换；保存才写 domain.toml）
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "引用组（只做收窄；组的启用/禁用去「能力」页，全局生效）";
                            color: Theme.palette.text_disabled;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.groups-dirty : Button {
                            text: "保存引用";
                            width: 96px;
                            height: 26px;
                            clicked => { root.save-groups(); }
                        }
                    }
                    Rectangle {
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.palette.border;
                        background: Theme.palette.surface_raised;
                        // 自动换行：FlexboxLayout 的 flex-wrap 默认 wrap。
                        // 组多时自动折行、容器随之增高，不再溢出遮住下方卡片。
                        chips := FlexboxLayout {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            spacing: 6px;
                            spacing-vertical: 6px;
                            flex-wrap: wrap;
                            alignment: start;
                            for c in root.group-chips : Rectangle {
                                width: 124px;
                                height: 24px;
                                border-radius: 12px;
                                border-width: c.declared ? 0px : 1px;
                                border-color: Theme.palette.border;
                                background: c.declared
                                    ? (c.enabled ? Theme.palette.primary : Theme.palette.border)
                                    : Theme.palette.surface;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        // 不用 "✓" 前缀：默认字体缺该字形会渲染成空心方块，
                                        // 选中状态已由蓝色底 + 白字表达。
                                        text: c.label + (c.enabled ? "" : "（全局禁用）");
                                        color: !c.enabled
                                            ? Theme.palette.text_disabled
                                            : (c.declared ? Theme.palette.on_primary : Theme.palette.text_secondary);
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                // 全局已禁用的组只能看、不能引：领域不能替全局做决定
                                TouchArea {
                                    x: 0;
                                    y: 0;
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => { if c.enabled { root.toggle-group(c.id); } }
                                }
                            }
                        }
                        height: chips.preferred-height + 16px;
                    }

                    // 未引用任何组 = 不做收敛（兼容老领域）。必须显性提示，
                    // 否则用户会以为"没引用就只剩基础工具"，或反过来以为"引用过才有效"。
                    if root.cur.groups.length == 0 : Text {
                        text: "当前没有引用任何组 → 工具面 = 全部组（不做收敛）。要收窄能力就点上面的 chips。";
                        color: Theme.palette.warning;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    // 工具面预览
                    Rectangle {
                        height: 58px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.palette.border;
                        background: Theme.palette.surface_raised;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 2px;
                            Text {
                                text: "工具面预览：将装配 " + root.cur.tools + " 个工具";
                                color: root.cur.tools == 0 && root.cur.groups.length > 0
                                     ? Theme.palette.warning : Theme.palette.text_primary;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            Text {
                                text: root.cur.tools == 0 && root.cur.groups.length > 0
                                    ? "声明了组却装配出 0 个工具：组 id 写错了，或这些组没有登记任何工具。"
                                    : "「能力」页可查看每个组里具体有哪些条目。";
                                color: Theme.palette.text_disabled;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }

                    // 知识管理（只读）：知识库清单，声明来自 domain.toml 的 [[kb]]
                    Rectangle {
                        height: root.cur.kb.length == 0 ? 54px : (36px + root.cur.kb.length * 28px);
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.palette.border;
                        background: Theme.palette.surface_raised;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 3px;
                            Text {
                                text: "知识管理（知识库 · 只读，在 domain.toml 用 [[kb]] 声明）";
                                color: Theme.palette.text_primary;
                                font-size: 11px;
                                font-weight: 600;
                            }
                            if root.cur.kb.length == 0 : Text {
                                text: "本领域没有登记知识库。数据（sqlite / 向量 / csv / 文件）由外部提供，这里只显示位置与条目数。";
                                color: Theme.palette.text_disabled;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            for k in root.cur.kb : Rectangle {
                                height: 26px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: k.label; color: Theme.palette.text_secondary; font-size: 10px; width: 76px; overflow: elide; vertical-alignment: center; }
                                    Text { text: k.location; color: Theme.palette.text_primary; font-size: 10px; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                    Text { text: k.purpose; color: Theme.palette.text_disabled; font-size: 10px; width: 150px; overflow: elide; vertical-alignment: center; }
                                    Text {
                                        text: k.error == "" ? ("共 " + k.entries + " 条") : "无法统计";
                                        color: k.error == "" ? Theme.palette.text_secondary : Theme.palette.warning;
                                        font-size: 10px;
                                        width: 78px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // 外部工具（领域私有）：不进 plugins/、不进全局注册表、不出现在能力页。
                    // 领域能自己管这些，是因为它们只在这个领域里有意义——
                    // 换领域就该一起消失，不该变成"全局装了但谁也不用"的孤儿。
                    Rectangle {
                        height: 92px + root.cur.external.length * 30px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.palette.border;
                        background: Theme.palette.surface_raised;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            Text {
                                text: "外部工具（" + root.cur.external.length + "）　领域私有：不进 plugins/、不受插件体系管理";
                                color: Theme.palette.text_primary;
                                font-size: 11px;
                                font-weight: 600;
                            }
                            HorizontalLayout { spacing: 4px;
                                Input {
                                    placeholder-text: "使用说明（给模型看：这个程序干什么、怎么用）";
                                    text <=> root.ext-usage;
                                    height: 26px;
                                    horizontal-stretch: 1;
                                }
                                Button { text: "加 exe…"; width: 78px; height: 26px; clicked => { root.ext-add-exe(); } }
                                Button { text: "加声明式…"; width: 86px; height: 26px; outlined: true; clicked => { root.ext-add-dir(); } }
                            }
                            if root.cur.external.length == 0 : Text {
                                text: "本领域还没有外部工具。加一个 exe（填路径 + 使用说明），或加一个带 PnC.toml 的声明式目录。";
                                color: Theme.palette.text_disabled;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            for e in root.cur.external : Rectangle {
                                height: 28px;
                                HorizontalLayout { spacing: 8px;
                                    Text {
                                        text: e.kind;
                                        color: Theme.palette.text_disabled;
                                        font-size: 10px;
                                        width: 62px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: e.name;
                                        color: e.error == "" ? Theme.palette.text_primary : Theme.palette.warning;
                                        font-size: 11px;
                                        width: 130px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: e.error == "" ? e.path : (e.path + "　—　" + e.error);
                                        color: e.error == "" ? Theme.palette.text_secondary : Theme.palette.warning;
                                        font-size: 10px;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Button { text: "移除"; width: 48px; height: 22px; outlined: true;
                                        clicked => { root.ext-remove(e.index); } }
                                }
                            }
                        }
                    }

                    // 知识条目（knowledge.md）：增删即改写该文件
                    Rectangle {
                        height: 130px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.palette.border;
                        background: Theme.palette.surface_raised;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            Text { text: "知识条目（" + root.knowledge.length + "）　写到 knowledge.md，随领域独立存放"; color: Theme.palette.text_primary; font-size: 11px; font-weight: 600; }
                            HorizontalLayout { spacing: 4px;
                                Input { placeholder-text: "条目标题"; text <=> root.knowledge-name; height: 26px; horizontal-stretch: 1; }
                                Button { text: "添加"; height: 26px; width: 56px; clicked => { root.knowledge-add(root.knowledge-name, root.knowledge-text); root.knowledge-name = ""; root.knowledge-text = ""; } }
                            }
                            ScrollView { height: 54px; content-width: self.width;
                                VerticalLayout { spacing: 2px;
                                    for k in root.knowledge : Rectangle {
                                        height: 24px;
                                        HorizontalLayout { spacing: 4px;
                                            Text { text: k.name; color: Theme.palette.text_secondary; font-size: 11px; horizontal-stretch: 1; overflow: elide; }
                                            Button { text: "删"; width: 34px; height: 20px; outlined: true; clicked => { root.knowledge-remove(k.name); } }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 领域级参数（卡片来自配置元数据，page == "domain" 的那张）
                    for c in cards : CfgCardView {
                        card: c;
                        field-edited(k, v) => { root.field-edited(k, v); }
                    }

                    Rectangle { height: 8px; }
                }
            }

            Rectangle { height: 1px; background: Theme.palette.border; }

            // ---- 下半：文件编辑器，固定占页面高度 50%（四个文件都在这一个框里编辑）----
            Rectangle {
                height: 50%;
                background: Theme.palette.surface;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.dom-file-name == "" ? "文件编辑" : ("文件编辑 · " + root.dom-file-name);
                            color: Theme.palette.text_primary;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Button { text: "domain.toml"; height: 26px; outlined: root.dom-file-name != "domain.toml"; clicked => { root.domain-file-read(root.cur.id, "domain.toml"); root.dom-file-name = "domain.toml"; } }
                        Button { text: "workflow.md"; height: 26px; outlined: root.dom-file-name != "workflow.md"; clicked => { root.domain-file-read(root.cur.id, "workflow.md"); root.dom-file-name = "workflow.md"; } }
                        Button { text: "knowledge.md"; height: 26px; outlined: root.dom-file-name != "knowledge.md"; clicked => { root.domain-file-read(root.cur.id, "knowledge.md"); root.dom-file-name = "knowledge.md"; } }
                        Button { text: "constraints.toml"; height: 26px; outlined: root.dom-file-name != "constraints.toml"; clicked => { root.domain-file-read(root.cur.id, "constraints.toml"); root.dom-file-name = "constraints.toml"; } }
                        Button { text: "保存文件"; height: 26px; clicked => { if root.dom-file-name != "" { root.domain-file-save(root.cur.id, root.dom-file-name, root.dom-file-text); } } }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.palette.border;
                        background: Theme.palette.surface_raised;
                        VerticalLayout {
                            padding: 6px;
                            if root.dom-file-name == "" : Text {
                                text: "上面选一个文件开始编辑（保存只写这一次的改动，不会碰其他文件）";
                                color: Theme.palette.text_disabled;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if root.dom-file-name != "" : TextEdit {
                                text <=> root.dom-file-text;
                                vertical-stretch: 1;
                                wrap: word-wrap;
                                font-size: 11px;
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// 页面：能力（组树 / 条目表 / 详情与装配报告）
//
// 这一页回答三个问题：基座现在有哪些组、每个组里有什么条目、
// 某个条目为什么没出现（未声明组 → 隔离区；组未被领域引用 → 不装配）。
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// 能力页（P0-5）：三栏 = 组树 / 条目表 / 详情与装配报告
//
// 数据来自 data/registry.toml（唯一真相源），而不是运行时注册表：
// 只有这样才能显示"未安装的插件"和"缺文件的条目"——它们在运行时根本不存在。
// ---------------------------------------------------------------------------
component AbilityPage inherits Rectangle {
    in property <[RegGroupRow]> groups;
    in property <[RegEntryRow]> entries;
    in property <string> summary;

    /// 选中条目的详情（Rust 按 id 查好后下发：界面不做循环过滤）
    in property <string> sel-id: "";
    in property <string> sel-name: "";
    in property <string> sel-group: "";
    in property <string> sel-source: "";
    in property <string> sel-risk: "";
    in property <string> sel-status: "";
    in property <string> sel-note: "";
    in property <bool> sel-installed: false;
    in property <bool> sel-installable: false;
    in property <bool> sel-enabled: false;

    callback pick-entry(string);
    /// (id, op)：op ∈ enable / disable / install / uninstall / group-on / group-off /
    ///   assign:<组id> / group-add:<名> / group-rename:<名> / group-remove / group-desc:<描述>
    callback op(string, string);
    callback pick-path(string, bool);

    in-out property <string> cur-group: "";
    in-out property <string> cur-entry: "";
    // 组管理（#5/#6）
    in-out property <string> new-group-name: "";
    in-out property <string> group-desc-edit: "";

    // 打开页面就选中第一个组：否则中栏永远空白，用户以为"没东西"。
    // 必须挂在 `changed groups` 上——`init` 执行时 Rust 还没下发数据。
    changed groups => {
        if (root.cur-group == "" && root.groups.length > 0) {
            root.cur-group = root.groups[0].id;
        }
    }

    HorizontalLayout {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        spacing: 1px;

        // ---- 左：组树 ----
        Rectangle {
            width: 236px;
            background: Theme.palette.surface;
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                Text {
                    text: "组（" + groups.length + "）";
                    color: Theme.palette.text_disabled;
                    font-size: 11px;
                    height: 20px;
                    vertical-alignment: center;
                }
                // 组多时必须能滚动：原来是无滚动的 VerticalLayout，溢出后把
                // 下面的「组管理」卡片（新建/改名/删组）挤出可视区，导致删不掉空组。
                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;
                    VerticalLayout {
                        width: parent.width;
                        spacing: 2px;
                        for g in groups : TouchArea {
                            height: 56px;
                            mouse-cursor: pointer;
                            clicked => { root.cur-group = g.id; root.cur-entry = ""; }
                            Rectangle {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            border-radius: 6px;
                            background: root.cur-group == g.id ? Theme.palette.surface_raised
                                      : Colors.transparent;
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                padding-top: 5px;
                                spacing: 1px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: !g.enabled ? Theme.palette.text_disabled
                                                  : (g.broken > 0 ? Theme.palette.warning
                                                     : (g.discovered > 0 ? Theme.palette.primary
                                                        : Theme.palette.success));
                                    }
                                    Text {
                                        text: g.label;
                                        color: g.enabled ? Theme.palette.text_primary : Theme.palette.text_disabled;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: g.active + "/" + g.total;
                                        color: Theme.palette.text_secondary;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: g.source + " · " + g.id
                                        + (g.broken > 0 ? " · 缺文件" + g.broken : "")
                                        + (g.discovered > 0 ? " · 未安装" + g.discovered : "");
                                    color: g.broken > 0 ? Theme.palette.warning : Theme.palette.text_disabled;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }
                            }
                        }
                    }
                }
                // 组管理（#5）：新建 / 改名 / 删除 / 描述
                Rectangle {
                    height: 116px;
                    border-radius: 6px;
                    background: Theme.palette.surface_raised;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Input { placeholder-text: "组名（如：抓包工具）——目录与 id 自动生成"; text <=> root.new-group-name; height: 26px; }
                        HorizontalLayout { spacing: 4px;
                            Button { text: "新建组"; height: 24px; horizontal-stretch: 1;
                                clicked => {
                                    // 空名字直接忽略：后端也会拒，但没必要让用户看一条报错
                                    if root.new-group-name != "" {
                                        root.op(root.new-group-name, "group-add:" + root.new-group-name);
                                        root.new-group-name = "";
                                    }
                                } }
                            Button { text: "改名"; height: 24px; horizontal-stretch: 1; outlined: true;
                                clicked => { root.op(root.cur-group, "group-rename:" + root.new-group-name); } }
                            Button { text: "删组"; height: 24px; width: 48px; outlined: true;
                                clicked => { root.op(root.cur-group, "group-remove"); } }
                        }
                        Input {
                            placeholder-text: "组描述（说明本组工具类别，便于模型调用）";
                            text: root.group-desc-edit;
                            height: 26px;
                            edited(t) => { root.group-desc-edit = t; }
                            accepted(t) => { root.op(root.cur-group, "group-desc:" + t); }
                        }
                    }
                }
            }
        }

        // ---- 中：条目表 ----
        Rectangle {
            width: 340px;
            background: Theme.palette.background;
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                Text {
                    text: "条目（" + root.cur-group + "）";
                    color: Theme.palette.text_disabled;
                    font-size: 11px;
                    height: 22px;
                    vertical-alignment: center;
                }
                // 条目多时可滚动（与组列表同理）
                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;
                    VerticalLayout {
                        width: parent.width;
                        spacing: 0px;
                        for e in entries : TouchArea {
                            // visible 防溢出绘制；零高度避免 visible:false 仍占 44px 导致当前组无法顶部对齐
                            visible: e.group == root.cur-group;
                            height: e.group == root.cur-group ? 44px : 0px;
                            mouse-cursor: pointer;
                            clicked => { root.cur-entry = e.id; root.pick-entry(e.id); }
                            Rectangle {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            border-radius: 6px;
                            background: root.cur-entry == e.id ? Theme.palette.surface_raised
                                      : Colors.transparent;
                            VerticalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 4px;
                                spacing: 1px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: e.id;
                                        color: e.installed && e.enabled && e.status == "ok"
                                               ? Theme.palette.text_primary : Theme.palette.text_disabled;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: e.status == "ok"
                                            ? (e.installed ? (e.enabled ? "" : "禁用") : "未安装")
                                            : (e.status == "broken" ? "缺文件" : "未安装");
                                        color: e.status == "broken" ? Theme.palette.warning : Theme.palette.text_disabled;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: e.source + " · " + e.risk + " · " + e.name;
                                    color: Theme.palette.text_disabled;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }
                            }
                        }
                    }
                }
            }
        }

        // ---- 右：详情 + 操作 + 装配报告 ----
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.palette.surface;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "详情";
                    color: Theme.palette.text_disabled;
                    font-size: 11px;
                    height: 18px;
                    vertical-alignment: center;
                }

                if root.sel-id == "" : Text {
                    text: "左栏选组、中栏选条目。\n\n· 组级：启用 / 停用 / 安装 / 卸载\n· 条目级：启用 / 禁用 / 安装 / 卸载";
                    color: Theme.palette.text_disabled;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                if root.sel-id != "" : Text {
                    text: root.sel-id;
                    color: Theme.palette.text_primary;
                    font-size: 13px;
                    font-weight: 600;
                }
                if root.sel-id != "" : Text {
                    text: root.sel-name + "　·　组 " + root.sel-group + "　·　" + root.sel-source
                        + "　·　风险 " + root.sel-risk;
                    color: Theme.palette.text_secondary;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                if root.sel-id != "" : Text {
                    text: "状态：" + (root.sel-status == "ok"
                        ? (root.sel-installed ? (root.sel-enabled ? "可用" : "已禁用") : "未安装")
                        : (root.sel-status == "broken" ? "缺文件" : "未安装"))
                        + (root.sel-note == "" ? "" : "（" + root.sel-note + "）");
                    color: root.sel-status == "broken" ? Theme.palette.warning : Theme.palette.text_secondary;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                // 条目级操作
                if root.sel-id != "" && root.sel-installed : HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    Button {
                        text: root.sel-enabled ? "禁用此条目" : "启用此条目";
                        height: 28px;
                        clicked => { root.op(root.sel-id, root.sel-enabled ? "disable" : "enable"); }
                    }
                    Button {
                        text: "卸载";
                        height: 28px;
                        outlined: true;
                        clicked => { root.op(root.sel-id, "uninstall"); }
                    }
                }
                if root.sel-id != "" && !root.sel-installed && root.sel-installable : HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    Button {
                        text: "安装此条目";
                        height: 28px;
                        clicked => { root.op(root.sel-id, "install"); }
                    }
                }
                // 未安装且文件不齐备：不给"安装"按钮，直接说明原因
                if root.sel-id != "" && !root.sel-installed && !root.sel-installable : Text {
                    text: "该条目缺可执行文件（dll 不在或清单写了不存在的 binary），补齐后重新扫描即可安装";
                    color: Theme.palette.warning;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                // 组↔条目绑定 / 分配（#6）：只有已安装的条目能换组（未安装先 install）
                if root.sel-id != "" && root.cur-group != "" && root.sel-installed : Text {
                    text: "分配到组（换组会移动目录与账本归属；未分配组不可启用）：";
                    color: Theme.palette.text_disabled;
                    font-size: 11px;
                }
                if root.sel-id != "" && root.cur-group != "" && root.sel-installed : Rectangle {
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.palette.border;
                    background: Theme.palette.surface_raised;
                    // 自动换行 + 高度随行数（组多时不再溢出）
                    chips2 := FlexboxLayout {
                        x: 8px;
                        y: 6px;
                        width: parent.width - 16px;
                        spacing: 6px;
                        spacing-vertical: 6px;
                        flex-wrap: wrap;
                        alignment: start;
                        for g in groups : Rectangle {
                            height: 24px;
                            min-width: 48px;
                            border-radius: 12px;
                            background: Theme.palette.surface;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    text: g.label;
                                    color: Theme.palette.text_secondary;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                x: 0;
                                y: 0;
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                // 当前组就是它自己：点了不改动
                                clicked => { if g.id != root.sel-group { root.op(root.sel-id, "move:" + g.id); } }
                            }
                        }
                    }
                    height: chips2.preferred-height + 12px;
                }

                // 组级操作
                if root.cur-group != "" : Rectangle {
                    height: 1px;
                    background: Theme.palette.border;
                }
                if root.cur-group != "" : Text {
                    text: "组 " + root.cur-group;
                    color: Theme.palette.text_secondary;
                    font-size: 11px;
                    height: 18px;
                    vertical-alignment: center;
                }
                if root.cur-group != "" : HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    Button {
                        text: "启用整组";
                        height: 28px;
                        clicked => { root.op(root.cur-group, "group-on"); }
                    }
                    Button {
                        text: "停用整组";
                        height: 28px;
                        outlined: true;
                        clicked => { root.op(root.cur-group, "group-off"); }
                    }
                    Button {
                        text: "安装整组";
                        height: 28px;
                        outlined: true;
                        clicked => { root.op(root.cur-group, "install"); }
                    }
                    Button {
                        text: "卸载整组";
                        height: 28px;
                        outlined: true;
                        clicked => { root.op(root.cur-group, "uninstall"); }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.palette.border;
                }
                Text {
                    text: "装配报告";
                    color: Theme.palette.text_disabled;
                    font-size: 11px;
                    height: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.summary;
                    color: Theme.palette.text_secondary;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                Text {
                    text: "缺文件 / 未安装的条目不会进工具面；装好并启用后需要重新装配才生效。";
                    color: Theme.palette.text_disabled;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                // 吸收剩余高度：否则 VerticalLayout 会把多出来的空间摊到每个块之间，
                // 看起来像"内容被拉开、中间一大片空白"
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "windpencilagent";
    icon: @image-url("../icons/app.png");
    // 用 preferred-* 而不是 width/height：后者把尺寸绑死，最大化时布局不跟着长，
    // 右边会留下一条没人管的空白（截图里一眼就能看出来）。
    preferred-width: 1180px;
    preferred-height: 780px;
    background: Theme.palette.background;

    // 主题（Rust 侧写入）
    in-out property <bool> is-dark: false;
    in-out property <int> font-size: 13;

    // 页面与状态
    in-out property <int> page: 0;
    in-out property <bool> busy: false;
    in-out property <string> version: "0.1.0";
    in-out property <string> status-line: "";
    in-out property <string> model-name: "";
    in-out property <string> space-name: "";
    in-out property <int> tool-count: 0;
    in-out property <int> ctx-window: 32000;
    in-out property <float> ctx-ratio: 0.0;
    in-out property <string> data-root: "";
    in-out property <string> draft: "";

    // 数据模型
    in-out property <[ChatMsg]> messages: [];
    in-out property <[TraceRow]> traces: [];
    in-out property <[ToolRow]> tools: [];
    in-out property <[SpaceRow]> spaces: [];
    in-out property <[ModelRow]> models: [];
    // 内置能力配置卡片（Rust 侧按配置元数据生成，界面不写死任何参数）
    // 配置拆成 4 个二级页：同一份卡片表在 Rust 侧按 `page` 分组后分别下发，
    // 界面不做过滤（本版 Slint 不支持 `for x : if cond : Component` 的写法）。
    in-out property <[CfgCard]> cfg-cards-model: [];
    in-out property <[CfgCard]> cfg-cards-capability: [];
    in-out property <[CfgCard]> cfg-cards-security: [];
    in-out property <[CfgCard]> cfg-cards-data: [];
    /// 领域页内嵌的领域级参数卡
    in-out property <[CfgCard]> cfg-cards-domain: [];
    in-out property <string> cfg-note: "";
    // 领域页数据（domains/ 下全部领域，含未激活）
    in-out property <[DomainCardRow]> domains: [];
    // 能力页数据（基座 8 组 + 各自的工具数）
    in-out property <[CapGroupRow]> cap-groups: [];
    // 空间页工具组勾选（复用领域组 chip 结构）
    in-out property <[DomainGroupChip]> space-group-chips: [];
    // 领域页组绑定（勾选改内存，保存写 domain.toml）
    in-out property <[DomainGroupChip]> domain-chips: [];
    in-out property <bool> domain-dirty: false;
    callback domain-pick(int);
    callback domain-toggle-group(string);
    callback domain-save-groups();
    // 能力页条目移动（组↔条目绑定）
    callback reg-move(string, string);

    // 模型档案编辑（P0-6）
    in-out property <bool> md-open: false;
    in-out property <bool> md-new: true;
    in-out property <string> md-name: "";
    in-out property <string> md-driver: "openai";
    in-out property <string> md-url: "";
    in-out property <string> md-model: "";
    in-out property <string> md-key: "";
    in-out property <string> md-ctx: "32000";
    in-out property <bool> md-tools: true;
    in-out property <bool> md-vision: false;
    in-out property <bool> md-enabled: true;
    callback model-new();
    callback model-edit(string);
    callback model-save();
    callback model-delete(string);

    // 能力页（注册表视图）
    in-out property <[RegGroupRow]> reg-groups: [];
    in-out property <[RegEntryRow]> reg-entries: [];
    in-out property <string> reg-summary: "";
    // 能力页选中条目的详情（Rust 查好后下发，界面不做循环过滤）
    in-out property <string> ab-id: "";
    in-out property <string> ab-name: "";
    in-out property <string> ab-group: "";
    in-out property <string> ab-source: "";
    in-out property <string> ab-risk: "";
    in-out property <string> ab-status: "";
    in-out property <string> ab-note: "";
    in-out property <bool> ab-installed: false;
    in-out property <bool> ab-installable: false;
    in-out property <bool> ab-enabled: false;
    // 对话页状态条
    in-out property <string> domain-name: "";
    in-out property <int> ctx-used: 0;
    in-out property <float> ctx-pct: 0.0;
    in-out property <int> tokens-in: 0;
    in-out property <int> tokens-out: 0;
    in-out property <[TaskRow]> tasks: [];
    // 任务看板四列（Rust 按 col 分好下发，Slint 侧不做过滤）
    in-out property <[TaskRow]> col0: [];
    in-out property <[TaskRow]> col1: [];
    in-out property <[TaskRow]> col2: [];
    in-out property <[TaskRow]> col3: [];
    in-out property <string> task-new-title: "";
    in-out property <[DayRow]> memory-days: [];
    in-out property <[string]> isolated: [];
    in-out property <[string]> knowledge-names: [];
    in-out property <[string]> skill-names: [];
    in-out property <int> c0: 0;
    in-out property <int> c1: 0;
    in-out property <int> c2: 0;
    in-out property <int> c3: 0;

    // 对话页选择器（#8）
    in-out property <[string]> space-options: [];
    in-out property <[string]> domain-options: [];
    in-out property <[string]> model-options: [];
    in-out property <bool> degraded: false;

    // 会话管理（#9.1）
    in-out property <[SessionRow]> sessions: [];
    // 会话预览（不动当前对话）
    in-out property <[ChatMsg]> session-view: [];
    in-out property <string> session-view-title: "";
    in-out property <string> session-view-meta: "";
    in-out property <string> session-view-id: "";

    // 空间编辑（#9/#14/#15）
    in-out property <string> edit-space: "";
    in-out property <string> edit-cwd: "";
    in-out property <string> edit-whitelist: "";
    in-out property <string> edit-permission: "global";
    in-out property <string> edit-sandbox: "off";
    in-out property <string> session-filter: "";

    // 领域管理（#7.1/#7.2）
    in-out property <string> new-domain-id: "";
    in-out property <string> new-domain-name: "";
    in-out property <[KnowledgeRow]> knowledge: [];
    in-out property <string> knowledge-name: "";
    in-out property <string> knowledge-text: "";
    in-out property <string> dom-file-name: "";
    in-out property <string> dom-file-text: "";
    // 领域概要（≤300 字）与 AI 生成配置的忙碌标记
    in-out property <string> dom-summary: "";
    /// 概要字数（Slint 字符串没有 length，由 Rust 侧在编辑时算好下发）
    in-out property <int> dom-summary-len: 0;
    in-out property <bool> ai-busy: false;

    // 记忆
    in-out property <string> curated-text: "";
    in-out property <string> daily-date: "";
    in-out property <string> daily-text: "";

    // 空间表单
    in-out property <string> new-space-name: "";
    in-out property <string> new-space-note: "";

    // 授权范围（设置页：一行一条规则）
    in-out property <string> scope-text: "";
    in-out property <string> scope-note: "";

    // 审批浮层
    in-out property <bool> approval-open: false;
    in-out property <string> approval-tool: "";
    in-out property <string> approval-risk: "";
    in-out property <string> approval-args: "";

    // 提示条
    in-out property <bool> toast-open: false;
    in-out property <string> toast-text: "";

    // 回调（Rust 侧接线）
    callback send(string);
    callback new-session();
    // 0=拒绝 1=本次放行 2=本轮会话生效 3=加入空间授权白名单
    callback approve(int);
    callback space-switch(string);
    callback space-create(string, string);
    callback space-remove(string);
    callback model-use(string);
    callback model-test(string);
    callback memory-load(string);
    callback memory-append(string);
    callback theme-change(bool);
    callback font-change(int);
    // 保存授权范围（一行一条规则；写回 [scope] authorized）
    callback scope-save(string);
    // 修改某个配置项（key, value）：立刻写盘并按分区热更新
    callback cfg-edit(string, string);
    callback open-config();
    callback tool-test(string);
    // 树包启停（写 registry.toml 并立即重新装配）
    callback tree-pkg-toggle(string, bool);
    // 重新装配（会话边界重读注册表与清单）
    callback tree-reload();
    // 切换领域：写配置 + 重新装配（领域影响 system prompt / 工具面 / 约束）
    callback domain-switch(string);
    // 能力页选中条目（Rust 按名字查快照后回填详情）
    callback ability-pick(string);
    // 能力页注册表操作：(id, op) —— op ∈ enable/disable/install/uninstall/group-on/group-off/assign:/group-add:/group-rename:/group-remove:/group-desc:
    callback reg-op(string, string);
    callback refresh();

    // ---- 本轮 20 条改动新增回调 ----
    // 对话页
    callback space-select(string);
    callback domain-select(string);
    callback model-select(string);
    callback copy-message(string);
    // 任务看板（#11）
    callback task-add(string);
    callback task-move(string, int);
    callback task-delete(string);
    // 空间 + 会话（#9/#9.1/#14/#15）
    callback space-save(string);
    callback pick-dir(string);
    callback session-list(string);
    callback session-open(string);
    callback session-delete(string);
    callback session-export(string);
    callback session-recall(string);
    // 会话预览（不动当前对话）
    callback preview-session(string);
    // 领域 + 知识（#7.1/#7.2）
    callback domain-create(string, string);
    callback domain-remove(string);
    callback domain-file-read(string, string);
    callback domain-file-save(string, string, string);
    callback knowledge-add(string, string);
    callback knowledge-remove(string);
    // 领域私有外部工具（`[[external]]`）
    in-out property <string> ext-usage;
    callback ext-add-exe();
    callback ext-add-dir();
    callback ext-remove(int);
    // 领域概要保存 + AI 生成四份配置
    callback save-summary(string, string);
    callback ai-generate(string);
    callback summary-edited();
    // 配置路径浏览（#13.1/#16）
    callback pick-path(string, bool);
    // 配置文本草稿 / 显式保存（本轮：改了能存进文件）
    callback cfg-draft(string, string);
    callback cfg-save();
    // 空间工具组勾选（按组授权，能选择不手书）
    callback space-pick(string);
    callback space-group-toggle(string);

    // 根布局显式铺满窗口：Window 里直接放布局时首选尺寸由子项决定，
    // 一旦子项首选宽度小于窗口（例如某页放的是固定宽度的表格），
    // 右侧就会露出一条没人管的窗口底色。100% 明确表示"跟窗口走"。
    HorizontalLayout {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            // ---------------- 左导航 ----------------
            Rectangle {
                width: 200px;
                background: Theme.palette.surface;
                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;

                    Text {
                        text: "windpencilagent";
                        color: Theme.palette.text_primary;
                        font-size: 17px;
                        font-weight: 700;
                        height: 30px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "通用智能体基座";
                        color: Theme.palette.text_disabled;
                        font-size: 10px;
                        height: 16px;
                    }

                    Rectangle { height: 8px; }

                    Button {
                        text: "+ 新会话";
                        height: 36px;
                        clicked => { root.new-session(); }
                    }

                    Rectangle { height: 6px; }

                    NavGroup {
                        title: "主界面";
                        NavItem { label: "对话"; icon: Icons.chat; index: 0; current: root.page; picked(p) => { root.page = p; } }
                        NavItem { label: "会话"; icon: Icons.history; index: 10; current: root.page; picked(p) => { root.page = p; root.session-list(""); } }
                        NavItem { label: "任务板"; icon: Icons.task-board; index: 1; current: root.page; picked(p) => { root.page = p; } }
                    }
                    NavGroup {
                        title: "领域与能力";
                        NavItem { label: "领域"; icon: Icons.domain; index: 2; current: root.page; picked(p) => { root.page = p; } }
                        NavItem { label: "能力"; icon: Icons.ability; index: 3; current: root.page; has-badge: true; badge-text: root.tool-count; picked(p) => { root.page = p; } }
                    }
                    NavGroup {
                        title: "数据";
                        NavItem { label: "记忆"; icon: Icons.memory; index: 4; current: root.page; picked(p) => { root.page = p; } }
                        NavItem { label: "空间"; icon: Icons.space; index: 5; current: root.page; picked(p) => { root.page = p; } }
                    }
                    // 配置是"组"，不是页面：4 个二级项各自是一页，每页只有 1~5 张卡。
                    // 缩进是为了让"这些是配置的子项"一眼可见，避免又变回 10 个平级项。
                    NavGroup {
                        title: "配置";
                        NavItem { label: "模型"; icon: Icons.model; index: 6; current: root.page; sub: true; picked(p) => { root.page = p; } }
                        NavItem { label: "内置能力"; icon: Icons.wrench; index: 7; current: root.page; sub: true; picked(p) => { root.page = p; } }
                        NavItem { label: "插件与安全"; icon: Icons.shield; index: 8; current: root.page; sub: true; picked(p) => { root.page = p; } }
                        NavItem { label: "数据与路径"; icon: Icons.database; index: 9; current: root.page; sub: true; picked(p) => { root.page = p; } }
                    }

                    Rectangle { vertical-stretch: 1; }

                    Rectangle {
                        height: 48px;
                        border-radius: 6px;
                        background: Theme.palette.surface_raised;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 2px;
                            Text {
                                text: root.space-name == "" ? "全局空间" : root.space-name;
                                color: Theme.palette.text_primary;
                                font-size: 11px;
                                overflow: elide;
                            }
                            Text {
                                text: root.model-name == "" ? "未配置模型" : root.model-name;
                                color: Theme.palette.text_disabled;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

        // ---------------- 中央 ----------------
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.palette.background;
            VerticalLayout {
                // 页头
                Rectangle {
                    height: 52px;
                    background: Theme.palette.background;
                    VerticalLayout {
                        padding-left: 20px;
                        padding-right: 16px;
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: root.page == 0 ? "对话"
                                    : root.page == 10 ? "会话"
                                    : root.page == 1 ? "任务板"
                                    : root.page == 2 ? "领域"
                                    : root.page == 3 ? "能力"
                                    : root.page == 4 ? "记忆"
                                    : root.page == 5 ? "空间"
                                    : root.page == 6 ? "配置 · 模型"
                                    : root.page == 7 ? "配置 · 内置能力"
                                    : root.page == 8 ? "配置 · 插件与安全"
                                    : root.page == 9 ? "配置 · 数据与路径"
                                    : root.page == 11 ? "组件库" : "会话";
                                color: Theme.palette.text_primary;
                                font-size: 15px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "刷新";
                                outlined: true;
                                width: 64px;
                                height: 30px;
                                clicked => { root.refresh(); }
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.palette.border;
                    }
                }

                // 视图区
                view-area := Rectangle {
                    vertical-stretch: 1;
                    ChatPage {
                        visible: root.page == 0;
                        x: 0;
                        y: 0;
                        width: view-area.width;
                        height: view-area.height;
                        messages: root.messages;
                        busy: root.busy;
                        model-name: root.model-name;
                        tool-count: root.tool-count;
                        space-name: root.space-name;
                        domain-name: root.domain-name;
                        space-options: root.space-options;
                        domain-options: root.domain-options;
                        model-options: root.model-options;
                        degraded: root.degraded;
                        ctx-window: root.ctx-window;
                        ctx-used: root.ctx-used;
                        ctx-pct: root.ctx-pct;
                        tokens-in: root.tokens-in;
                        tokens-out: root.tokens-out;
                        space-select(n) => { root.space-select(n); }
                        domain-select(n) => { root.domain-select(n); }
                        model-select(n) => { root.model-select(n); }
                        copy-message(t) => { root.copy-message(t); }
                        jump-space() => { root.page = 5; }
                        jump-model() => { root.page = 6; }
                        jump-config() => { root.page = 7; }
                    }
                    TaskPage {
                        visible: root.page == 1;
                        x: 0;
                        y: 0;
                        width: view-area.width;
                        height: view-area.height;
                        tasks: root.tasks;
                        col0: root.col0; col1: root.col1; col2: root.col2; col3: root.col3;
                        c0: root.c0; c1: root.c1; c2: root.c2; c3: root.c3;
                        new-title <=> root.task-new-title;
                        task-add(t) => { root.task-add(t); }
                        task-move(id, c) => { root.task-move(id, c); }
                        task-delete(id) => { root.task-delete(id); }
                    }
                    // 领域：列表 + 组引用 + 工具面预览 + 四文件（§8.6）
                    DomainPage {
                        visible: root.page == 2;
                        x: 0;
                        y: 0;
                        width: view-area.width;
                        height: view-area.height;
                        domains: root.domains;
                        cards: root.cfg-cards-domain;
                        note: root.cfg-note;
                        group-chips: root.domain-chips;
                        groups-dirty: root.domain-dirty;
                        new-domain-id <=> root.new-domain-id;
                        new-domain-name <=> root.new-domain-name;
                        knowledge: root.knowledge;
                        knowledge-name <=> root.knowledge-name;
                        knowledge-text <=> root.knowledge-text;
                        dom-file-name <=> root.dom-file-name;
                        dom-file-text <=> root.dom-file-text;
                        dom-summary <=> root.dom-summary;
                        ext-usage <=> root.ext-usage;
                        dom-summary-len: root.dom-summary-len;
                        ai-busy: root.ai-busy;
                        switch-to(id) => { root.domain-switch(id); }
                        field-edited(k, v) => { root.cfg-edit(k, v); }
                        pick-domain(i) => { root.domain-pick(i); }
                        toggle-group(g) => { root.domain-toggle-group(g); }
                        save-groups() => { root.domain-save-groups(); }
                        domain-create(id, n) => { root.domain-create(id, n); }
                        domain-remove(id) => { root.domain-remove(id); }
                        domain-file-read(id, f) => { root.domain-file-read(id, f); }
                        domain-file-save(id, f, t) => { root.domain-file-save(id, f, t); }
                        knowledge-add(n, t) => { root.knowledge-add(n, t); }
                        knowledge-remove(n) => { root.knowledge-remove(n); }
                        ext-add-exe() => { root.ext-add-exe(); }
                        ext-add-dir() => { root.ext-add-dir(); }
                        ext-remove(i) => { root.ext-remove(i); }
                        save-summary(id, s) => { root.save-summary(id, s); }
                        ai-generate(id) => { root.ai-generate(id); }
                        summary-edited => { root.summary-edited(); }
                    }
                    // 能力：组树 / 条目表 / 详情与装配报告（§8.5）
                    AbilityPage {
                        visible: root.page == 3;
                        x: 0;
                        y: 0;
                        width: view-area.width;
                        height: view-area.height;
                        groups: root.reg-groups;
                        entries: root.reg-entries;
                        summary: root.reg-summary;
                        sel-id: root.ab-id;
                        sel-name: root.ab-name;
                        sel-group: root.ab-group;
                        sel-source: root.ab-source;
                        sel-risk: root.ab-risk;
                        sel-status: root.ab-status;
                        sel-note: root.ab-note;
                        sel-installed: root.ab-installed;
                        sel-installable: root.ab-installable;
                        sel-enabled: root.ab-enabled;
                        pick-entry(n) => { root.ability-pick(n); }
                        op(id, what) => { root.reg-op(id, what); }
                    }
                    MemoryPage {
                        visible: root.page == 4;
                        x: 0;
                        y: 0;
                        width: view-area.width;
                        height: view-area.height;
                        days: root.memory-days;
                        curated: root.curated-text;
                        daily-date: root.daily-date;
                        daily-text: root.daily-text;
                        space-name: root.space-name;
                        load(d) => { root.memory-load(d); }
                        append-daily(t) => { root.memory-append(t); }
                    }
                    SpacePage {
                        visible: root.page == 5;
                        x: 0;
                        y: 0;
                        width: view-area.width;
                        height: view-area.height;
                        spaces: root.spaces;
                        sessions: root.sessions;
                        groups: root.cap-groups;
                        group-chips: root.space-group-chips;
                        new-name <=> root.new-space-name;
                        new-note <=> root.new-space-note;
                        edit-space <=> root.edit-space;
                        edit-cwd <=> root.edit-cwd;
                        edit-whitelist <=> root.edit-whitelist;
                        edit-permission <=> root.edit-permission;
                        edit-sandbox <=> root.edit-sandbox;
                        session-filter <=> root.session-filter;
                        switch-to(n) => { root.space-switch(n); }
                        create() => { root.space-create(root.new-space-name, root.new-space-note); }
                        remove(n) => { root.space-remove(n); }
                        space-save(n) => { root.space-save(n); }
                        space-pick(n) => { root.space-pick(n); }
                        space-toggle-group(id) => { root.space-group-toggle(id); }
                        pick-dir(k) => { root.pick-dir(k); }
                        session-list(f) => { root.session-list(f); }
                        session-open(id) => { root.session-open(id); }
                        session-delete(id) => { root.session-delete(id); }
                        session-export(id) => { root.session-export(id); }
                        session-recall(id) => { root.session-recall(id); }
                        copy-message(t) => { root.copy-message(t); }
                    }
                    // 配置·模型 = 档案列表（上）+ 当前档案参数（下）。
                    // 列表是"可插拔的多份档案"，下半是"这一份的具体字段"——
                    // 两者生命周期不同，所以分两块而不是混成一张卡（§8.2 的理由）。
                    ModelPage {
                        visible: root.page == 6;
                        ed-open <=> root.md-open;
                        ed-new <=> root.md-new;
                        ed-name <=> root.md-name;
                        ed-driver <=> root.md-driver;
                        ed-url <=> root.md-url;
                        ed-model <=> root.md-model;
                        ed-key <=> root.md-key;
                        ed-ctx <=> root.md-ctx;
                        ed-tools <=> root.md-tools;
                        ed-vision <=> root.md-vision;
                        ed-enabled <=> root.md-enabled;
                        new-model() => { root.model-new(); }
                        edit-model(n) => { root.model-edit(n); }
                        save-model() => { root.model-save(); }
                        delete-model(n) => { root.model-delete(n); }
                        x: 0;
                        y: 0;
                        width: view-area.width;
                        height: 248px;
                        models: root.models;
                        active-name: root.model-name;
                        use(n) => { root.model-use(n); }
                        test(n) => { root.model-test(n); }
                    }
                    Rectangle {
                        visible: root.page == 6;
                        x: 0;
                        y: 248px;
                        width: view-area.width;
                        height: 1px;
                        background: Theme.palette.border;
                    }
                    // 其余 3 个配置二级页：同一份卡片表在 Rust 侧按 page 分组后下发
                    ConfigPage {
                        visible: root.page == 6;
                        x: 0;
                        y: 249px;
                        width: view-area.width;
                        height: view-area.height - 249px;
                        note: root.cfg-note;
                        cards: root.cfg-cards-model;
                        field-edited(k, v) => { root.cfg-edit(k, v); }
                        field-draft(k, v) => { root.cfg-draft(k, v); }
                        save-config => { root.cfg-save(); }
                        pick-path(k, d) => { root.pick-path(k, d); }
                    }
                    ConfigPage {
                        visible: root.page == 7;
                        x: 0;
                        y: 0;
                        width: view-area.width;
                        height: view-area.height;
                        note: root.cfg-note;
                        cards: root.cfg-cards-capability;
                        field-edited(k, v) => { root.cfg-edit(k, v); }
                        field-draft(k, v) => { root.cfg-draft(k, v); }
                        save-config => { root.cfg-save(); }
                        pick-path(k, d) => { root.pick-path(k, d); }
                    }
                    ConfigPage {
                        visible: root.page == 8;
                        x: 0;
                        y: 0;
                        width: view-area.width;
                        height: view-area.height;
                        note: root.cfg-note;
                        cards: root.cfg-cards-security;
                        field-edited(k, v) => { root.cfg-edit(k, v); }
                        field-draft(k, v) => { root.cfg-draft(k, v); }
                        save-config => { root.cfg-save(); }
                        pick-path(k, d) => { root.pick-path(k, d); }
                    }
                    ConfigPage {
                        visible: root.page == 9;
                        x: 0;
                        y: 0;
                        width: view-area.width;
                        height: view-area.height;
                        note: root.cfg-note;
                        cards: root.cfg-cards-data;
                        field-edited(k, v) => { root.cfg-edit(k, v); }
                        field-draft(k, v) => { root.cfg-draft(k, v); }
                        save-config => { root.cfg-save(); }
                        pick-path(k, d) => { root.pick-path(k, d); }
                    }
                    SessionPage {
                        visible: root.page == 10;
                        x: 0;
                        y: 0;
                        width: view-area.width;
                        height: view-area.height;
                        spaces: root.spaces;
                        sessions: root.sessions;
                        view: root.session-view;
                        view-title: root.session-view-title;
                        view-meta: root.session-view-meta;
                        view-id <=> root.session-view-id;
                        list(f) => { root.session-list(f); }
                        view-session(id) => { root.preview-session(id); }
                        open(id) => { root.session-open(id); }
                        recall(id) => { root.session-recall(id); }
                        delete(id) => { root.session-delete(id); }
                        export(id) => { root.session-export(id); }
                        new-session => { root.new-session(); }
                    }
                    KitGallery {
                        visible: root.page == 11;
                        x: 0;
                        y: 0;
                        width: view-area.width;
                        height: view-area.height;
                    }
                }

                // 输入区（仅对话页）
                if root.page == 0 : Rectangle {
                    height: 104px;
                    background: Theme.palette.background;
                    Rectangle {
                        y: 0px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.palette.border;
                    }
                    VerticalLayout {
                        // 嵌套布局在普通 Rectangle 里只取首选宽度（实测输入框
                        // 比内容区窄 90px），必须显式绑父宽。
                        x: 0;
                        y: 1px;
                        width: parent.width;
                        height: 103px;
                        padding: 12px;
                        spacing: 8px;
                        Rectangle {
                            height: 48px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: draft-edit.has-focus ? Theme.palette.primary : Theme.palette.border;
                            background: Theme.palette.surface_raised;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 8px;
                                draft-edit := TextEdit {
                                    text <=> root.draft;
                                    font-size: 13px;
                                    wrap: no-wrap;
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: root.busy ? "处理中" : "发送";
                                    disabled: root.busy || root.draft == "";
                                    width: 76px;
                                    height: 32px;
                                    clicked => {
                                        if (root.draft != "") {
                                            root.send(root.draft);
                                            root.draft = "";
                                        }
                                    }
                                }
                            }
                        }
                        Text {
                            text: "Enter 发送 · 高风险工具会弹出审批卡片（超时视为拒绝）";
                            color: Theme.palette.text_disabled;
                            font-size: 10px;
                        }
                    }
                }
            }
        }

        // ---------------- 右栏 ----------------
        Rectangle {
            width: 272px;
            background: Theme.palette.surface;
            // 实例必须显式给几何：组件根虽然自己写了 100%，但"实例在一个
            // 非布局的 Rectangle 里"时不会自动撑开，结果是右栏整块空白
            // （界面上看起来像"右侧留了一条灰边"）。
            RightRail {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                traces: root.traces;
                tasks: root.tasks;
                status-line: root.status-line;
                tool-count: root.tool-count;
                ctx-ratio: root.ctx-ratio;
                ctx-window: root.ctx-window;
            }
        }
    }

    // ---------------- 审批浮层 ----------------
    if root.approval-open : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: rgba(0, 0, 0, 0.35);

        Rectangle {
            x: (root.width - 460px) / 2;
            y: (root.height - 250px) / 2;
            width: 460px;
            height: 290px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.palette.border;
            background: Theme.palette.surface_raised;
            drop-shadow-blur: 24px;
            drop-shadow-color: rgba(0, 0, 0, 0.25);

            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: "高风险操作需要授权";
                    color: Theme.palette.text_primary;
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    text: "工具 " + root.approval-tool + "　·　风险 " + root.approval-risk;
                    color: Theme.palette.critical;
                    font-size: 12px;
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.palette.border;
                    background: Theme.palette.surface;
                    VerticalLayout {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        padding: 8px;
                        Text {
                            text: root.approval-args;
                            color: Theme.palette.text_secondary;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
                Text {
                    text: "放行范围：本次仅此一次；本轮会话对该工具免询问；空间白名单永久授权当前空间。";
                    color: Theme.palette.text_disabled;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    height: 34px;
                    spacing: 8px;
                    Button {
                        text: "拒绝";
                        outlined: true;
                        width: 64px;
                        height: 34px;
                        clicked => { root.approve(0); }
                    }
                    Button {
                        text: "本次放行";
                        width: 88px;
                        height: 34px;
                        clicked => { root.approve(1); }
                    }
                    Button {
                        text: "本轮会话";
                        width: 88px;
                        height: 34px;
                        outlined: true;
                        clicked => { root.approve(2); }
                    }
                    Button {
                        text: "空间白名单";
                        width: 100px;
                        height: 34px;
                        outlined: true;
                        clicked => { root.approve(3); }
                    }
                }
            }
        }
    }

    // ---------------- 提示条 ----------------
    // 4 秒自动收起：否则上一条提示会一直压在右上角，挡住页头与看板。
    Timer {
        interval: 4s;
        running: root.toast-open;
        triggered => { root.toast-open = false; }
    }

    if root.toast-open : Rectangle {
        x: root.width - 336px;
        y: 66px;
        width: 320px;
        height: 56px;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.palette.border;
        background: Theme.palette.surface_raised;
        drop-shadow-blur: 16px;
        drop-shadow-color: rgba(0, 0, 0, 0.18);
        Text {
            x: 10px;
            y: 10px;
            width: parent.width - 20px;
            height: parent.height - 20px;
            text: root.toast-text;
            color: Theme.palette.text_primary;
            font-size: 12px;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        toast-ta := TouchArea {
            clicked => { root.toast-open = false; }
        }
    }

    // 主题联动
    init => {
        Theme.is_dark = root.is-dark;
    }
    changed is-dark => {
        Theme.is_dark = root.is-dark;
    }
}
